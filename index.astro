---
import Base from "../layouts/Base.astro";
import TrustStrip from "../components/TrustStrip.astro";
import CompareTable from "../components/CompareTable.astro";
import Faq from "../components/Faq.astro";
import { airlines } from "../data/airlines.js";

const fmt = (n) => n.toLocaleString("en-US");

const jsonld = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "buyflightmiles",
  url: "https://buyflightmiles.com",
  description: "Buy airline miles for premium-cabin redemptions. Secure transfer, fast delivery.",
};
---
<Base
  title="Buy Airline Miles | Fast, Secure Delivery | buyflightmiles"
  description="Buy airline miles at a fraction of the price. Delta, United, American, Singapore and more — secure transfer, delivered within 24 hours, delivery guaranteed."
  jsonld={jsonld}
>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div>
          <span class="kicker">Miles · delivered</span>
          <h1>Fly business for the price of economy.</h1>
          <p class="sub">Buy the miles you're short across every major program. Secure transfer, delivered within hours, backed by a guarantee.</p>
          <div class="cta-row">
            <a class="btn btn-primary" href="#programs">View live pricing</a>
            <a class="btn btn-secondary" href="#how">How it works</a>
          </div>
          <div class="spec">
            <span><b>24h</b> delivery</span><span>·</span>
            <span><b>99.9%</b> completion</span><span>·</span>
            <span><b>4.8/5</b> Trustpilot</span>
          </div>
        </div>
        <div>
          <div class="tbox" style="padding:22px">
            <p class="lab" style="margin-bottom:14px">Featured · lowest price</p>
            <p class="pname" style="font-size:22px">Singapore KrisFlyer</p>
            <div class="price" style="margin:10px 0 2px"><span class="num" style="font-size:38px">1.8¢</span><span class="unit">/ mile</span></div>
            <p class="alt" style="margin-bottom:14px">≈ $18 per 1,000 miles</p>
            <a class="btn btn-primary" href="/buy/krisflyer" style="width:100%">Buy KrisFlyer</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROGRAMS -->
  <section class="section" id="programs">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Programs</span>
        <h2>Choose your program</h2>
        <p>Live pricing across every program we cover. Each links to full details and delivery times.</p>
      </div>
      <div class="grid">
        {airlines.map((a) => (
          <a class="gcard" href={`/buy/${a.slug}`}>
            <div class="top">
              <div>
                <div class="pname">{a.program}</div>
                <div class="plabel">{a.airline}</div>
              </div>
              {a.inStock
                ? <span class="badge badge-ok">In stock</span>
                : <span class="badge badge-warn">Limited</span>}
            </div>
            <div class="price">{a.pricePerMile}¢ <small>/ mile</small></div>
            <div class="meta"><span>{a.delivery.replace("Within ", "")}</span><span>{a.alliance}</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- TRUST -->
  <section class="section" id="trust" style="padding-top:0">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Why trust us</span>
        <h2>Built for buyers who've been burned</h2>
        <p>Buying miles should feel as safe as any purchase. Here's what backs every order.</p>
      </div>
      <TrustStrip />
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section" id="how" style="padding-top:0">
    <div class="container">
      <div class="section-head">
        <h2>Three steps to your miles</h2>
        <p>Simple, secure, and fast — most transfers complete within a day.</p>
      </div>
      <div class="steps">
        <div class="step"><div class="n">01</div><h4>Select &amp; enter</h4><p>Pick the program, the amount, and your loyalty account number.</p></div>
        <div class="step"><div class="n">02</div><h4>Pay securely</h4><p>Complete payment through our protected checkout.</p></div>
        <div class="step"><div class="n">03</div><h4>Miles land</h4><p>They post to your account, usually within 24 hours.</p></div>
      </div>
    </div>
  </section>

  <!-- COMPARE -->
  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="section-head">
        <h2>Us vs. buying direct</h2>
        <p>Airlines sell their own miles at a steep markup. Here's the difference.</p>
      </div>
      <CompareTable program="miles" pricePerMile={1.8} />
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq" style="padding-top:0">
    <div class="container" style="max-width:760px">
      <div class="section-head">
        <h2>Questions, answered</h2>
      </div>
      <Faq delivery="24 hours" />
    </div>
  </section>
</Base>
