---
import "../styles/flightdeck.css";
import { getCollection } from "astro:content";

// Nav + footer program lists are generated from the collection, so adding an
// entry to airlines.json puts it in the navigation automatically — the roster
// is heading toward ~40 programs and a hand-maintained list would go stale.
const programs = (await getCollection("airlines"))
  .map((e) => ({ slug: e.id, ...e.data }))
  .sort((a, b) => a.order - b.order);

const {
  title = "buyflightmiles — Buy airline miles, delivered fast",
  description = "Buy airline miles at a fraction of the price. Secure transfer, fast delivery, backed by our delivery guarantee.",
  slug = "",
  jsonld = null,
} = Astro.props;

const site = Astro.site ?? new URL("https://buyflightmiles.com");
const canonical = new URL(slug, site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=IBM+Plex+Mono:wght@500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
  <header class="site-header">
    <div class="container bar">
      <a href="/" class="brand">buy<span>flight</span><em>miles</em></a>
      <nav class="nav">
        <details class="dd" id="nav-dd">
          <summary class="link dd-t">Programs
            <svg class="dd-c" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <div class="dd-panel">
            <div class="dd-grid">
              {programs.map((p) => (
                <a class="dd-item" href={`/buy/${p.slug}`}>
                  <span class="dd-code" style={`--c:${p.color}`}>{p.code}</span>
                  <span class="dd-txt">
                    <span class="dd-air">{p.airline}</span>
                    <span class="dd-prog">{p.program}</span>
                  </span>
                  <span class="dd-price">{p.priceVerified ? "" : "~"}{p.pricePerMile}¢</span>
                </a>
              ))}
            </div>
            <a class="dd-all" href="/#programs">Compare all {programs.length} programs →</a>
          </div>
        </details>
        <a class="link" href="/agents">For agents</a>
        <a class="link" href="/blog">Journal</a>
        <a class="link" href="/#faq">FAQ</a>
        <a class="btn btn-primary" href="/#programs" style="padding:9px 18px">View pricing</a>
      </nav>
    </div>
  </header>

  <script is:inline>
    // Programs dropdown: <details> already handles click + keyboard natively.
    // This only adds close-on-outside-click and Escape.
    (function () {
      const dd = document.getElementById("nav-dd");
      if (!dd) return;
      document.addEventListener("click", (e) => {
        if (dd.open && !dd.contains(e.target)) dd.open = false;
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && dd.open) {
          dd.open = false;
          dd.querySelector("summary").focus();
        }
      });
    })();
  </script>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="cols">
        <div>
          <div class="brand">buy<span>flight</span><em>miles</em></div>
          <p style="color:#B7AA8E; font-size:13.5px; max-width:36ch; margin-top:12px; line-height:1.6;">
            Buy airline miles for premium-cabin redemptions. Secure transfer, fast delivery, every order backed by our guarantee.
          </p>
        </div>
        <div>
          <h5>Programs</h5>
          {programs.map((p) => (
            <a href={`/buy/${p.slug}`}>{p.airline} {p.program}</a>
          ))}
        </div>
        <div>
          <h5>Company</h5>
          <a href="/agents">For agents &amp; brokers</a>
          <a href="/blog">News &amp; guides</a>
          <a href="/#how">How it works</a>
          <a href="/#faq">FAQ</a>
          <a href="/#trust">Why trust us</a>
        </div>
      </div>
      <div class="fine">© {new Date().getFullYear()} buyflightmiles · Not affiliated with any airline or loyalty program.</div>
    </div>
  </footer>
</body>
</html>
