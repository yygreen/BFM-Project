---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import TrustStrip from "../../components/TrustStrip.astro";
import Faq from "../../components/Faq.astro";
import QuoteWidget from "../../components/QuoteWidget.astro";
import SavingsTool from "../../components/SavingsTool.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection } from "astro:content";
import { getPosts } from "../../lib/blog";
import { site, realReviews, yearsTrading } from "../../lib/site";
import { usd, per1000 as per1000Of, costOf } from "../../lib/money";

// each locale named in its own language, the way a reader looking for it
// would recognise it
const LOCALE_NAMES: Record<string, string> = { ar: "العربية", de: "Deutsch" };

export async function getStaticPaths() {
  const airlines = (await getCollection("airlines")).map((e) => ({ slug: e.id, ...e.data }));
  const posts = await getPosts();
  return airlines.map((a) => ({
    params: { slug: a.slug },
    props: {
      a,
      airlines,
      // blog posts that reference this program — bidirectional linking,
      // so the blog feeds the money pages rather than sitting beside them
      posts: posts.filter((p) => p.data.programs.includes(a.slug)).slice(0, 2),
    },
  }));
}

const { a, airlines, posts } = Astro.props;
const per1000 = per1000Of(a.pricePerMile);
const verified = a.priceVerified;
// program name without any parenthetical — "Avios (Privilege Club)" reads
// fine as a title but turns copy like "price your … order" into a mouthful
const progShort = a.program.replace(/\s*\(.*\)$/, "");
// "LifeMiles miles" and "Asia Miles miles" read like a stutter — skip the
// suffix when the program name already ends in it
const progMiles = /miles$/i.test(progShort) ? progShort : `${progShort} miles`;
// The h1 highlights the phrase the page is written for, which is the thing a
// visitor is checking they landed on. The phrase is named in the data rather
// than inferred from the sentence, so a reworded headline can't quietly
// highlight the wrong run of words; if it isn't found, the h1 renders plain.
const hi = a.heroHighlight && a.heroHeadline.indexOf(a.heroHighlight);
const head = hi >= 0
  ? {
      lead: a.heroHeadline.slice(0, hi),
      name: a.heroHighlight,
      tail: a.heroHeadline.slice(hi + a.heroHighlight.length),
    }
  : null;

const rev = realReviews[0];
const years = yearsTrading();
const related = a.related
  .map((slug) => airlines.find((x) => x.slug === slug))
  .filter(Boolean);

// Only publish a firm price in structured data once it's confirmed —
// unverified programs advertise availability + a quote path instead.
const jsonld = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: /miles$/i.test(a.program) ? `${a.airline} ${a.program}` : `${a.airline} ${a.program} miles`,
  description: a.metaDescription,
  brand: { "@type": "Brand", name: a.airline },
  offers: {
    "@type": "Offer",
    priceCurrency: "USD",
    availability: a.inStock ? "https://schema.org/InStock" : "https://schema.org/LimitedAvailability",
    ...(verified && {
      price: per1000,
      priceSpecification: {
        "@type": "UnitPriceSpecification",
        price: per1000,
        priceCurrency: "USD",
        referenceQuantity: { "@type": "QuantitativeValue", value: 1000, unitText: "miles" },
      },
    }),
  },
};
---
<Base
  title={a.metaTitle}
  description={a.metaDescription}
  slug={`buy/${a.slug}`}
  jsonld={jsonld}
  alternates={Object.keys(a.i18n ?? {}).map((loc) => ({ hreflang: loc, slug: `${loc}/buy/${a.slug}` }))}
>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid top">
        <div>
          <Breadcrumbs items={[
            { label: "Home", href: "/" },
            { label: "Programs", href: "/#programs" },
            { label: `${a.airline} ${progShort}` },
          ]} />
          <span class="kicker">{a.alliance}</span>
          {/* one toggle per translation the entry carries, so a new market
              needs no edit here — only the locale's own name below */}
          {Object.keys(a.i18n ?? {}).map((loc) => (
            <a class="lang-toggle" href={`/${loc}/buy/${a.slug}`} lang={loc} hreflang={loc}>{LOCALE_NAMES[loc] ?? loc}</a>
          ))}
          <h1>{head ? <>{head.lead}<span class="hl">{head.name}</span>{head.tail}</> : a.heroHeadline}</h1>
          <p class="sub">{a.heroSub}</p>
          {/* Both buttons used to point at #quote, which sits beside them in
              the hero: on a desktop screen the target is already in view, so
              the click does nothing and the pair reads as decoration. Each now
              goes somewhere the visitor isn't. */}
          <div class="cta-row">
            <a class="btn btn-primary" href={`/order?program=${a.slug}`}>{verified ? `Buy ${progShort}` : "Request a live quote"}</a>
            <a class="btn btn-secondary" href={`/calculator/${a.slug}`}>What's it cost?</a>
          </div>
          <!-- social proof row: rating, turnaround, track record. Each slot
               falls back to an always-true claim when its figure isn't
               confirmed, so the row converts without ever inventing a number. -->
          <div class="spec">
            {rev ? (
              <span class="spec-it">
                <svg viewBox="0 0 24 24" fill="#F5A623" stroke="none" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <b>{rev.rating}/{rev.outOf}</b>&nbsp;on {rev.platform}
              </span>
            ) : (
              <span class="spec-it">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                Free, no-obligation quote
              </span>
            )}
            <!-- the window shows for every program; the 14 unverified ones
                 are already check:launch blockers, so this is a staged claim
                 the client confirms, not a silent invention -->
            <span class="spec-it">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              Delivered in <b>{a.delivery.replace("Within ", "")}</b>
            </span>
            {years !== null ? (
              <span class="spec-it">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
                <b>{years}+ years</b>&nbsp;in business
              </span>
            ) : (
              <span class="spec-it">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                Exact price confirmed before you pay
              </span>
            )}
          </div>
        </div>
        <div class="hero-art">
          <div class="hero-calc" id="quote">
            <QuoteWidget defaultSlug={a.slug} locked heading={`What will ${progMiles} cost?`} sub="Price it, then request your free, no-obligation quote. We confirm your exact rate before you pay." />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BEST WAYS TO USE + RUN THE NUMBERS — one section: the ladder makes the
       value claim, and the tool that tests it against a real fare sits in the
       same room rather than a section of its own -->
  <section class="section wash-cool" id="uses">
    <div class="container">
      <div class="section-head">
        <h2>Best ways to use {a.program}</h2>
        <p>Where these miles stretch furthest, and when to keep your cash. Test any of it against a real fare on the right.</p>
      </div>
      <div class="value-split">
      <div class="value-lad">
      {a.sweetSpots && a.sweetSpots.length > 0 && (
      <>
        <!-- three tiers in descending visual weight: priced cards, then flat
             cards, then a muted line — the hierarchy IS the verdict -->
        <div class="vtier">
          <div class="vtier-head">
            <span class="vchip v1">Great value</span>
            <span class="vtier-note">The redemptions worth buying miles for</span>
          </div>
          <div class="uses">
            {a.sweetSpots.map((s) => (
              <div class="use">
                <h4>{s.title}</h4>
                {s.miles && (
                  <div class="use-cost">
                    from {s.miles.toLocaleString("en-US")} miles · {verified ? "" : "~"}{usd(costOf(s.miles, a.pricePerMile))} at our rate
                  </div>
                )}
                <p>{s.desc}</p>
              </div>
            ))}
          </div>
        </div>
        {a.valueBands && (
          <div class="vtier">
            <div class="vtier-head">
              <span class="vchip v2">Good value</span>
              <span class="vtier-note">Solid uses when the cash fare is high</span>
            </div>
            <div class="vgood">
              {a.valueBands.good.map((x) => <div class="vitem">{x}</div>)}
            </div>
          </div>
        )}
        {a.valueBands && (
          <div class="vtier">
            <div class="vtier-head">
              <span class="vchip v3">Skip it, pay cash</span>
              <span class="vtier-note">Where miles waste their value</span>
            </div>
            <p class="vskip">{a.valueBands.skip.join("  ·  ")}</p>
          </div>
        )}
      </>
      )}
      </div>
      <div class="value-tool">
        <div class="worth-sub" id="worth">
          <h3>Does buying {progShort} beat the cash fare?</h3>
          <p>Paste the price from your flight search. If cash wins, we'll say so.</p>
        </div>
        <SavingsTool program={a.program} rate={a.pricePerMile} verified={a.priceVerified} presets={a.sweetSpots.filter((x) => x.miles).map((x) => ({ title: x.title, miles: x.miles }))} />
        <p class="tool-more">
          Just want the arithmetic? The <a href={`/calculator/${a.slug}`}>{progShort} miles calculator</a> has
          order sizes, break-evens and the math spelled out.
        </p>
      </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS + COMPARE, folded into one slim band. The old two sections
       repeated the widget's own numbers (rate, min/max, delivery) and retold
       the process the hero already explains — and the "protected checkout"
       step copy contradicted the payment-off-site rule. What survives is the
       one thing the widget doesn't say: the airline-price-on-the-quote note. -->
  <section class="section" id="how">
    <div class="container">
      <div class="section-head">
        <h2>From quote to {progShort} in your account</h2>
      </div>
      <!-- the same three beats, same names, as the homepage's "Three steps to
           the seat" — one story told twice, not two competing processes -->
      <div class="steps ministeps">
        <div class="step"><div class="n">01</div><h4>Choose</h4><p>Price your amount in the calculator above. We confirm your exact rate and delivery in the quote.</p></div>
        <div class="step"><div class="n">02</div><h4>Pay</h4><p>Off-site, after you approve the quote. Nothing is ever charged on this website.</p></div>
        <div class="step"><div class="n">03</div><h4>Fly</h4><p>{a.deliveryVerified ? `Miles land in your own ${progShort} account, ${a.delivery.toLowerCase()} — then book the seat.` : `Miles land in your own ${progShort} account on the window your quote confirms — then book the seat.`}</p></div>
      </div>
      <p class="cmp-note" style="margin-top:26px">
        {a.airline} sets its own price for {progShort}, and it moves with their promotions.
        Quoting a figure we can't stand behind would help nobody, so we put the airline's
        current price next to yours <b>on the quote itself</b> — the difference is in front
        of you while you still have the choice.
      </p>
    </div>
  </section>

  <!-- QUIRKS + FACTS — what makes this program ITSELF, honest bits included -->
  {(a.quirks.length > 0 || a.mechanics.length > 0) && (
    <section class="section wash-neutral">
      <div class="container">
        <div class="section-head">
          <h2>Worth knowing about {a.program}</h2>
          <p>The details that change how you should buy and spend these miles.</p>
        </div>
        <div class="quirkfacts">
          {a.quirks.length > 0 && (
            <div class="quirks">
              {a.quirks.map((q) => (
                <div class="quirk">
                  <h4>{q.title}</h4>
                  <p>{q.text}</p>
                </div>
              ))}
            </div>
          )}
          {a.mechanics.length > 0 && (
            <div class="facts">
              <p class="lab">The facts</p>
              {a.mechanics.map((f) => (
                <div class="row"><span>{f.label}</span><b>{f.text}</b></div>
              ))}
              {a.factsChecked && <p class="cap">Program facts checked {a.factsChecked}. Policies move; we re-check before every quote.</p>}
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- TRUST -->
  <section class="section wash-warm">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Why trust us</span>
        <h2>Every {a.program} order is protected</h2>
      </div>
      <TrustStrip />
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <div class="section-head"><h2>Buying {a.airline} miles — your questions</h2></div>
      <Faq delivery={a.delivery} airline={a.airline} program={a.program} pricePerMile={a.pricePerMile} priceVerified={a.priceVerified} extras={a.faqExtras} />
    </div>
  </section>

  <!-- CLOSING CTA — the widget lives in the hero, so the page ends with a
       clear road back to it. Related programs ride along in the same band
       rather than floating as their own sparse section. -->
  <section class="section wash-cool">
    <div class="container">
      <div class="ctaband">
        <div>
          <h3>Ready to price your {progShort} order?</h3>
          <p>Free, no-obligation quote first, miles delivered {a.delivery.toLowerCase()}. Nothing is charged on this site.</p>
        </div>
        <a class="btn btn-primary" href="#quote">{verified ? `Price ${progShort} now` : "Request a live quote"}</a>
      </div>
      {related.length > 0 && (
        <div class="related related-inline">
          <span class="related-lab">Related programs</span>
          {related.map((r) => (
            <a href={`/buy/${r.slug}`}>{r.airline} {r.program} · {r.pricePerMile}¢</a>
          ))}
          <a href={`/calculator/${a.slug}`}>{progShort} calculator</a>
          <a href="/request">Another program? Ask us →</a>
          <a href="/contact">Questions? Contact us →</a>
        </div>
      )}
    </div>
  </section>

  <!-- FROM THE BLOG -->
  {posts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <span class="kicker">From the blog</span>
          <h2>Latest on {a.program}</h2>
        </div>
        <div class="postlist postlist-2">
          {posts.map((p) => <PostCard post={p} />)}
        </div>
      </div>
    </section>
  )}

</Base>
