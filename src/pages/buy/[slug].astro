---
import Base from "../../layouts/Base.astro";
import TrustStrip from "../../components/TrustStrip.astro";
import CompareTable from "../../components/CompareTable.astro";
import Faq from "../../components/Faq.astro";
import QuoteWidget from "../../components/QuoteWidget.astro";
import SavingsTool from "../../components/SavingsTool.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection } from "astro:content";
import { getPosts } from "../../lib/blog";
import { site } from "../../lib/site";

export async function getStaticPaths() {
  const airlines = (await getCollection("airlines")).map((e) => ({ slug: e.id, ...e.data }));
  const posts = await getPosts();
  return airlines.map((a) => ({
    params: { slug: a.slug },
    props: {
      a,
      airlines,
      // blog posts that reference this programme — bidirectional linking,
      // so the blog feeds the money pages rather than sitting beside them
      posts: posts.filter((p) => p.data.programs.includes(a.slug)).slice(0, 2),
    },
  }));
}

const { a, airlines, posts } = Astro.props;
const per1000 = Math.round(a.pricePerMile * 10);
const verified = a.priceVerified;
const related = a.related
  .map((slug) => airlines.find((x) => x.slug === slug))
  .filter(Boolean);

// Only publish a firm price in structured data once it's confirmed —
// unverified programs advertise availability + a quote path instead.
const jsonld = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: `${a.airline} ${a.program} miles`,
  description: a.metaDescription,
  brand: { "@type": "Brand", name: a.airline },
  offers: {
    "@type": "Offer",
    priceCurrency: "USD",
    availability: a.inStock ? "https://schema.org/InStock" : "https://schema.org/LimitedAvailability",
    ...(verified && {
      price: per1000,
      priceSpecification: {
        "@type": "UnitPriceSpecification",
        price: per1000,
        priceCurrency: "USD",
        referenceQuantity: { "@type": "QuantitativeValue", value: 1000, unitText: "miles" },
      },
    }),
  },
};
---
<Base title={a.metaTitle} description={a.metaDescription} slug={`buy/${a.slug}`} jsonld={jsonld}>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div>
          <span class="kicker">{a.alliance}</span>
          <h1>{a.heroHeadline}</h1>
          <p class="sub">{a.heroSub}</p>
          <div class="cta-row">
            <a class="btn btn-primary" href="#quote">{verified ? `Buy ${a.program}` : "Request a live quote"}</a>
            <a class="btn btn-secondary" href="#quote">What's it cost?</a>
          </div>
          <div class="spec">
            <span><b>{a.deliveryVerified ? a.delivery.replace("Within ", "") : "fast"}</b> delivery</span><span>·</span>
            <span><b>{verified ? "" : "~"}{a.pricePerMile}¢</b> / mile</span><span>·</span>
            <span><b>{site.guarantee.verified ? "Guaranteed" : "Quoted first"}</b></span>
          </div>
        </div>
        <div class="hero-art">
          <div class="hero-calc" id="quote">
            <QuoteWidget defaultSlug={a.slug} locked heading={`What will ${a.program} miles cost?`} sub="Price it, then send the request. We confirm your exact rate before you pay." />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BEST WAYS TO USE -->
  {a.sweetSpots && a.sweetSpots.length > 0 && (
    <section class="section" id="uses">
      <div class="container">
        <div class="section-head">
          <h2>Best ways to use {a.program}</h2>
          <p>Where these miles stretch furthest, and when to keep your cash.</p>
        </div>
        <!-- three tiers in descending visual weight: priced cards, then flat
             cards, then a muted line — the hierarchy IS the verdict -->
        <div class="vtier">
          <div class="vtier-head">
            <span class="vchip v1">Great value</span>
            <span class="vtier-note">The redemptions worth buying miles for</span>
          </div>
          <div class="uses">
            {a.sweetSpots.map((s) => (
              <div class="use">
                <h4>{s.title}</h4>
                {s.miles && (
                  <div class="use-cost">
                    from {s.miles.toLocaleString("en-US")} miles · {verified ? "" : "~"}${Math.round((s.miles * a.pricePerMile) / 100).toLocaleString("en-US")} at our rate
                  </div>
                )}
                <p>{s.desc}</p>
              </div>
            ))}
          </div>
        </div>
        {a.valueBands && (
          <div class="vtier">
            <div class="vtier-head">
              <span class="vchip v2">Good value</span>
              <span class="vtier-note">Solid uses when the cash fare is high</span>
            </div>
            <div class="vgood">
              {a.valueBands.good.map((x) => <div class="vitem">{x}</div>)}
            </div>
          </div>
        )}
        {a.valueBands && (
          <div class="vtier">
            <div class="vtier-head">
              <span class="vchip v3">Skip it, pay cash</span>
              <span class="vtier-note">Where miles waste their value</span>
            </div>
            <p class="vskip">{a.valueBands.skip.join("  ·  ")}</p>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- RUN THE NUMBERS — the visitor's own fare vs our rate, verdict included.
       Sits directly under the value ladder: the ladder makes the claim, this
       lets the visitor test it against a fare they actually found. -->
  <section class="section" style="padding-top:0" id="worth">
    <div class="container">
      <div class="section-head">
        <h2>Does buying {a.program.split(" ")[0]} beat the cash fare?</h2>
        <p>Paste the price from your flight search. If cash wins, we'll say so.</p>
      </div>
      <SavingsTool program={a.program} rate={a.pricePerMile} verified={a.priceVerified} presets={a.sweetSpots.filter((x) => x.miles).map((x) => ({ title: x.title, miles: x.miles }))} />
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section" id="how">
    <div class="container">
      <div class="section-head">
        <h2>How it works</h2>
        <p>From order to miles in your account — usually within a day.</p>
      </div>
      <div class="steps">
        <div class="step"><div class="n">01</div><h4>Select &amp; enter</h4><p>Choose your amount and enter your {a.program} account number.</p></div>
        <div class="step"><div class="n">02</div><h4>Pay securely</h4><p>Complete payment through our protected checkout.</p></div>
        <div class="step"><div class="n">03</div><h4>Miles land</h4><p>{a.program} miles post to your account, {a.delivery.toLowerCase()}.</p></div>
      </div>
    </div>
  </section>

  <!-- COMPARE -->
  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="section-head">
        <h2>Buy {a.program} here vs. from {a.airline}</h2>
        <p>Airlines charge a steep premium for their own miles. Here's the difference.</p>
      </div>
      <CompareTable program={a.program} pricePerMile={a.pricePerMile} priceVerified={a.priceVerified} delivery={a.deliveryVerified ? a.delivery : ""} directBuyCents={a.directBuyCents} min={a.min} max={a.max} />
    </div>
  </section>

  <!-- QUIRKS + FACTS — what makes this programme ITSELF, honest bits included -->
  {(a.quirks.length > 0 || a.mechanics.length > 0) && (
    <section class="section" style="padding-top:0">
      <div class="container">
        <div class="section-head">
          <h2>Worth knowing about {a.program}</h2>
          <p>The details that change how you should buy and spend these miles.</p>
        </div>
        <div class="quirkfacts">
          {a.quirks.length > 0 && (
            <div class="quirks">
              {a.quirks.map((q) => (
                <div class="quirk">
                  <h4>{q.title}</h4>
                  <p>{q.text}</p>
                </div>
              ))}
            </div>
          )}
          {a.mechanics.length > 0 && (
            <div class="facts">
              <p class="lab">The facts</p>
              {a.mechanics.map((f) => (
                <div class="row"><span>{f.label}</span><b>{f.text}</b></div>
              ))}
              {a.factsChecked && <p class="cap">Programme facts checked {a.factsChecked}. Policies move; we re-check before every quote.</p>}
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- TRUST -->
  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Why trust us</span>
        <h2>Every {a.program} order is protected</h2>
      </div>
      <TrustStrip />
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="padding-top:0">
    <div class="container" style="max-width:760px">
      <div class="section-head"><h2>Buying {a.airline} miles — your questions</h2></div>
      <Faq delivery={a.delivery} airline={a.airline} program={a.program} pricePerMile={a.pricePerMile} priceVerified={a.priceVerified} extras={a.faqExtras} />
    </div>
  </section>

  <!-- CLOSING CTA — the widget lives in the hero, so the page ends with a
       clear road back to it -->
  <section class="section tinted" style="padding:38px 0">
    <div class="container ctaband">
      <div>
        <h3>Ready to price your {a.program} order?</h3>
        <p>Quoted first, delivered {a.delivery.toLowerCase()}. Nothing is charged on this site.</p>
      </div>
      <a class="btn btn-primary" href="#quote">{verified ? `Price ${a.program.split(" ")[0]} now` : "Request a live quote"}</a>
    </div>
  </section>

  <!-- FROM THE BLOG -->
  {posts.length > 0 && (
    <section class="section" style="padding-top:0">
      <div class="container">
        <div class="section-head">
          <span class="kicker">From the blog</span>
          <h2>Latest on {a.program}</h2>
        </div>
        <div class="postlist postlist-2">
          {posts.map((p) => <PostCard post={p} />)}
        </div>
      </div>
    </section>
  )}

  <!-- RELATED -->
  {related.length > 0 && (
    <section class="section" style="padding-top:0">
      <div class="container">
        <div class="section-head"><h2>Related programs</h2></div>
        <div class="related">
          {related.map((r) => (
            <a href={`/buy/${r.slug}`}>{r.airline} {r.program} · {r.pricePerMile}¢</a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
