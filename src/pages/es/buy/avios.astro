---
// Avios currency page, Spanish — the /buy/avios thesis for the market that
// searches "comprar avios" (1,300/mo at KD 26 in `es`, SEO.md §build queue 7).
//
// Spain is Iberia's home market, so this page leads with the same rule the
// English page states — the cheapest confirmed rate is not always the one
// that can take your order — plus the fact a Spanish buyer cares about most:
// the Avios we sell as British Airways or Qatar move 1:1 into Iberia Club.
//
// A static file rather than a locale-route entry because, like the English
// page, it is a CURRENCY page: it compares programmes, and the i18n machinery
// generates one page per programme. Everything it states is derived from the
// same verified collection, so it can never drift from the programme pages,
// and its converted figures are euros from the ECB — named as such, because
// the Spanish locale's default note names exchangerate-api for the peso and
// misattributing a source is a claim like any other.
//
// Copy rules mirror the English page: the unqualified term only ("comprar
// avios"), carrier names in the body and never in the title or h1, and a flat
// breadcrumb. Written by a non-native model: `reviewed` lives in the Iberia
// i18n block for the programme page, and THIS page joins the same native-
// review list via SEO.md before launch.
import Base from "../../../layouts/Base.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import QuoteWidget from "../../../components/QuoteWidget.astro";
import FlightSearch from "../../../components/FlightSearch.astro";
import Emblem from "../../../components/Emblem.astro";
import TrustStrip from "../../../components/TrustStrip.astro";
import { getCollection } from "astro:content";
import { usd, costOf, rateFixed } from "../../../lib/money";
import { LOCALES } from "../../../lib/locales";
import { FLIGHT_SECTION, FLIGHTS } from "../../../lib/flight-locales";
import { fxFor, fxDate, moneyTpl, money } from "../../../lib/fx";

const L = LOCALES.es;
const FSEC = FLIGHT_SECTION.es;
const NUM = "es-ES"; // Spain, not the registry's Colombian default
const n = (v: number) => v.toLocaleString(NUM);

const all = (await getCollection("airlines")).map((e) => ({ slug: e.id, ...e.data }));
const ba = all.find((a) => a.slug === "british-airways-avios");
const qr = all.find((a) => a.slug === "qatar-avios");

const skus = all
  .filter((a) => a.program.startsWith("Avios"))
  .sort((x, y) => x.pricePerMile - y.pricePerMile);

// Same central rule as the English page, from confirmed prices and limits only.
const priced = skus.filter((a) => a.priceVerified && a.limitsVerified);
const cheapest = priced[0];
const lowestMin = [...priced].sort((x, y) => x.min - y.min)[0];
const switchAt = cheapest.min;
const example = 100000;
const saving = costOf(example, qr.pricePerMile) - costOf(example, ba.pricePerMile);

// Euros as a reading aid beside the dollar prices, ECB-sourced and dated.
// The dollar figure stays the price; every converted figure says so.
const fx = fxFor("EUR");
const stamp = fx?.date ? fxDate(fx.date, NUM) : "";
const eur = (usdAmount: number) => (fx ? money(usdAmount * fx.rate, "EUR", NUM) : null);

const widget = {
  ...L.widget,
  ...(fx
    ? {
        fxRate: fx.rate,
        fxMoney: moneyTpl("EUR"),
        fxNote: `≈ {v} al cambio del BCE del ${stamp} · el cobro es en dólares`,
      }
    : {}),
};

// The uses ladder renders from the Iberia block's own Spanish copy — the
// other programmes' sweet spots exist only in English, and a half-translated
// section is worse than a shorter one.
const iberia = skus.find((s) => s.slug === "iberia-avios");
const uses = iberia?.i18n?.es?.uses ?? [];

const per1000 = (c: number) => Math.round(c * 1000) / 100;
const jsonld = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Avios",
  description:
    "Avios entregados en una cuenta de fidelización que ya tienes, transferibles 1:1 entre los programas que comparten la moneda.",
  brand: { "@type": "Brand", name: "Avios" },
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "USD",
    offerCount: priced.length,
    lowPrice: per1000(priced[0].pricePerMile),
    highPrice: per1000(priced[priced.length - 1].pricePerMile),
    availability: priced.every((s) => s.inStock)
      ? "https://schema.org/InStock"
      : "https://schema.org/LimitedAvailability",
  },
};

// The same five questions as the English page, with the expiry answer widened
// to the difference a Spanish buyer actually meets: Iberia's terms don't
// count a transfer as activity, BA's do.
const faqs = [
  {
    q: "¿Avios es una sola moneda o varias?",
    a: "Una sola. British Airways, Iberia, Qatar Airways Privilege Club, Finnair y Aer Lingus usan los mismos Avios, y los saldos se mueven entre ellos 1:1 y al instante. Lo que cambia entre programas es lo que cuesta cada premio y los recargos que lleva, no la moneda.",
  },
  {
    q: "¿Cuáles me conviene comprar?",
    a: `Por debajo de ${n(switchAt)} Avios, ${lowestMin.airline} es la única tarifa confirmada que puede aceptar el pedido: su mínimo es ${n(lowestMin.min)} frente a ${n(cheapest.min)}. A partir de ${n(switchAt)}, ${cheapest.airline} sale más barato por Avios. En cualquier caso son los mismos Avios una vez entregados: compra el que encaje con tu cantidad y muévelos después al programa desde el que quieras reservar.`,
  },
  {
    q: "¿Puedo mover los Avios a Iberia o a Finnair?",
    a: `Sí, 1:1. Entregamos en la cuenta de ${skus.map((s) => s.airline).join(", ")} que ya tienes, y desde ahí los mueves tú mismo. Finnair Plus, Aer Lingus AerClub, Vueling Club y Loganair Loyalty también son transferibles, pero no entregamos directamente en ellos.`,
  },
  {
    q: "¿Avios es lo mismo que QMiles?",
    a: "Sí. Qatar Airways retiró los QMiles en 2022 y convirtió todos los saldos a Avios, la misma moneda que usan British Airways, Iberia y Finnair. Todo lo que leas sobre QMiles se aplica ahora a los Avios.",
  },
  {
    q: "¿Caducan los Avios?",
    a: "A los 36 meses sin actividad en la cuenta, y una sola acumulación o un solo canje, por pequeño que sea, reinicia todo el saldo. Un matiz que importa en España: según las condiciones de Iberia, una transferencia de Avios no cuenta como actividad en Iberia Club, mientras que en British Airways sí. Mantén viva una cuenta de Iberia con una acumulación o un canje, no con una transferencia.",
  },
];

const jsonldFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---
<Base
  title={`Comprar Avios | Una moneda, ${skus.length} precios | buyflightmiles`}
  description={`Compra Avios desde ${rateFixed(cheapest.pricePerMile)}¢. Una sola moneda, ${skus.length} programas donde comprarla, transferible 1:1 y entregada en la cuenta que ya tienes.`}
  slug="es/buy/avios"
  lang="es"
  alternates={[{ hreflang: "en", slug: "buy/avios" }]}
  jsonld={[jsonld, jsonldFaq]}
>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid top">
        <div>
          <Breadcrumbs items={[
            { label: "Inicio", href: "/" },
            { label: "Programas", href: "/#programs" },
            { label: "Avios" },
          ]} />
          <span class="kicker">La moneda de Oneworld</span>
          <a class="lang-toggle" href="/buy/avios" lang="en" hreflang="en">
            <span class="lang-flag" aria-hidden="true">🇺🇸</span>English
          </a>
          <h1>Compra <span class="hl">Avios</span> al más barato de {skus.length} precios.</h1>
          <p class="sub">
            British Airways, Iberia, Qatar, Finnair, Aer Lingus, Vueling y Loganair funcionan
            con los mismos Avios, y se mueven entre esas cuentas 1:1. Así que la pregunta no es
            qué aerolínea: es cuál sale más barata para la cantidad que necesitas.
          </p>
          <p class="hero-more">
            <a href="#which">¿Cuál me conviene comprar?</a>
          </p>
          <div class="spec">
            <span class="spec-it">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
              Desde <b>{rateFixed(cheapest.pricePerMile)}¢</b>&nbsp;por Avios
            </span>
            <span class="spec-it">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              Entrega en <b>{ba.delivery.replace("Within ", "").replace("hours", "horas")}</b>
            </span>
            <span class="spec-it">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="17 1 21 5 17 9"/><path d="M3 5h18"/><polyline points="7 23 3 19 7 15"/><path d="M21 19H3"/></svg>
              Transferibles <b>1:1</b>&nbsp;entre programas
            </span>
          </div>
        </div>
        <div class="hero-art">
          <div class="hero-calc" id="quote">
            <QuoteWidget
              only={skus.map((s) => s.slug)}
              defaultSlug={cheapest.slug}
              heading="¿Cuánto costarán tus Avios?"
              sub={`Cambia entre los ${skus.length} y mira cómo varían el precio y el mínimo.`}
              labels={widget}
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHICH ONE -->
  <section class="section wash-cool" id="which">
    <div class="container">
      <div class="section-head">
        <h2>Los mismos Avios, {skus.length} formas de comprarlos</h2>
        <p>
          La tarifa confirmada más barata no siempre está a tu alcance: lleva el pedido mínimo
          más alto. Esa es la decisión, y cambia en {n(switchAt)} Avios.
        </p>
      </div>

      <div class="avios-split" style={`--n:${skus.length}`}>
        {skus.map((s) => (
          <div class="pcard avios-card">
            <div class="top">
              <Emblem code={s.code} color={s.color} logo={s.logo} logoAlt={s.logoAlt} size={44} />
              {s.inStock
                ? <span class="badge badge-ok">En stock</span>
                : <span class="badge badge-warn">Limitado</span>}
            </div>
            <p class="plabel">{s.airline}</p>
            <p class="pname">{s.program.replace(/^Avios\s*\((.*)\)$/, "$1")}</p>
            <div class="price">
              <span class="num">{s.priceVerified ? "" : "~"}{rateFixed(s.pricePerMile)}¢</span><span class="unit">/ Avios</span>
            </div>
            <div class="rows">
              <div class="r"><span>Pedido mínimo</span><b>{n(s.min)}</b></div>
              <div class="r"><span>Máximo</span><b>{n(s.max)}</b></div>
              <div class="r"><span>Entrega</span><b>{s.deliveryVerified ? s.delivery.replace("Within ", "").replace("hours", "horas") : "con la cotización"}</b></div>
              <div class="r"><span>{n(example)} Avios</span><b>{s.priceVerified ? "" : "~"}{usd(costOf(example, s.pricePerMile))}</b></div>
            </div>
            {s.i18n?.es
              ? <a class="btn btn-primary" href={`/es/buy/${s.slug}`}>Ver Avios de {s.airline}</a>
              : <a class="btn btn-primary" href="#quote">Cotizar estos Avios</a>}
          </div>
        ))}
      </div>

      <div class="avios-rule">
        <div class="ar-row">
          <span class="ar-k">Menos de {n(switchAt)}</span>
          <span class="ar-v">
            <b>{lowestMin.airline}</b>: la única tarifa confirmada que acepta un pedido así,
            desde {n(lowestMin.min)} Avios.
          </span>
        </div>
        <div class="ar-row">
          <span class="ar-k">{n(switchAt)} o más</span>
          <span class="ar-v">
            <b>{cheapest.airline}</b>: más barato por Avios. En {n(example)} son
            {" "}{usd(saving)}{eur(saving) ? ` (≈ ${eur(saving)})` : ""} menos que los mismos Avios comprados a través de {qr.airline}.
          </span>
        </div>
      </div>
      <p class="avios-note">
        Una vez entregados son los mismos Avios. Compra el que encaje con tu cantidad y muévelos
        después al programa desde el que quieras reservar. Los precios se cobran en dólares;
        {fx ? ` los importes en euros son orientativos, al cambio del BCE del ${stamp}.` : ""}
      </p>
    </div>
  </section>

  <!-- TRANSFERS -->
  <section class="section" id="transfer">
    <div class="container">
      <div class="section-head">
        <h2>A dónde pueden ir tus Avios</h2>
        <p>
          Vincula las cuentas y los Avios se mueven 1:1, al instante y en ambos sentidos.
          Entregamos en los programas que vendemos; desde ahí son tuyos para moverlos.
        </p>
      </div>
      <div class="avios-web">
        <div class="aw-col">
          <span class="aw-lab">Entregamos en</span>
          {skus.map((s) => (
            <a class="aw-item aw-sell" href={s.i18n?.es ? `/es/buy/${s.slug}` : `/buy/${s.slug}`}>
              <span class="aw-logo">
                <Emblem code={s.code} color={s.color} logo={s.logo} logoAlt={s.logoAlt} size={32} />
              </span>
              <span class="aw-txt">
                <b>{s.airline}</b>
                <span>{s.priceVerified ? "" : "~"}{rateFixed(s.pricePerMile)}¢ · desde {n(s.min)}</span>
              </span>
            </a>
          ))}
        </div>
        <div class="aw-col">
          <span class="aw-lab">Puedes moverlos 1:1 a</span>
          <div class="aw-item"><span class="aw-txt"><b>Finnair Plus</b><span>Premios Oneworld vía Helsinki</span></span></div>
          <div class="aw-item"><span class="aw-txt"><b>Aer Lingus AerClub</b><span>Menos recargos que el metal de BA en el Atlántico</span></span></div>
          <div class="aw-item"><span class="aw-txt"><b>Vueling Club</b><span>Corto radio por España y Europa</span></span></div>
          <div class="aw-item"><span class="aw-txt"><b>Loganair Loyalty</b><span>Rutas regionales en el Reino Unido</span></span></div>
          <p class="aw-foot">
            No entregamos directamente en ninguno de estos. Los mueves tú mismo cuando los Avios
            lleguen a una cuenta en la que sí entregamos.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FLIGHTS -->
  <section class="section wash-warm" id="flights">
    <div class="container">
      <div class="section-head">
        <span class="kicker">{FSEC.kicker}</span>
        <h2>{FSEC.h2}</h2>
        <p>{FSEC.p}</p>
      </div>
      <FlightSearch
        program="Avios"
        heading={FSEC.cardHead}
        sub={FSEC.cardSub}
        moreLink={false}
        labels={FLIGHTS.es}
      />
    </div>
  </section>

  <!-- USES — the Iberia block's own Spanish copy -->
  {uses.length > 0 && (
    <section class="section" id="uses">
      <div class="container">
        <div class="section-head">
          <h2>En qué merece la pena gastar los Avios</h2>
          <p>Donde más rinden en el programa de casa.</p>
        </div>
        <div class="uses">
          {uses.map((x) => (
            <div class="use">
              <h4>{x.title}</h4>
              <p>{x.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- TRUST -->
  <section class="section wash-cool">
    <div class="container">
      <div class="section-head"><h2>Cada pedido de Avios está protegido</h2></div>
      <TrustStrip labels={L.trust} />
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <div class="section-head"><h2>Comprar Avios: tus preguntas</h2></div>
      <div class="faqx-list">
        {faqs.map((f, i) => (
          <details class="faq" open={i === 0}>
            <summary><span class="faq-q">{f.q}</span><span class="faq-mk" aria-hidden="true"></span></summary>
            <div class="ans">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA + related -->
  <section class="section wash-cool">
    <div class="container">
      <div class="ctaband">
        <div>
          <h3>¿Listo para poner precio a tus Avios?</h3>
          <p>Cotización gratis y sin compromiso primero. En este sitio no se cobra nada.</p>
        </div>
        <a class="btn btn-primary" href="#quote">Cotizar Avios</a>
      </div>
      <div class="related related-inline">
        <span class="related-lab">Sigue aquí</span>
        <a href="/es/buy/iberia-avios">Avios de Iberia · {iberia?.priceVerified ? "" : "~"}{rateFixed(iberia?.pricePerMile ?? 0)}¢</a>
        <a href="/es/calculator/iberia-avios">Calculadora de Avios</a>
        <a href="/buy/avios" lang="en" hreflang="en">This page in English →</a>
      </div>
    </div>
  </section>
</Base>
