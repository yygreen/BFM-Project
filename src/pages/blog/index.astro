---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import BlogSidebar from "../../components/BlogSidebar.astro";
import { getPosts, getCategoryCounts, categorySlug } from "../../lib/blog";

const posts = await getPosts();
const categories = await getCategoryCounts();

// A post flagged `featured` leads; otherwise the newest does.
const lead = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p.id !== lead?.id);

const jsonld = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "buyflightmiles journal",
  description: "Programme news, devaluations and guides for buying airline miles.",
  url: "https://buyflightmiles.com/blog",
};
---
<Base
  title="Miles News & Guides | buyflightmiles"
  description="Programme news, devaluations, sweet spots and practical guides for buying airline miles — written for people booking premium cabins."
  slug="blog"
  jsonld={jsonld}
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Journal</span>
        <h2>Miles news &amp; guides</h2>
        <p>Programme changes, devaluations and how-to guides — with the sources, so you can check them.</p>
      </div>

      {categories.length > 0 && (
        <nav class="cat-bar" aria-label="Post categories">
          <span class="cat-chip on">All<span class="n">{posts.length}</span></span>
          {categories.map((c) => (
            <a class="cat-chip" href={`/blog/category/${c.slug}`}>{c.name}<span class="n">{c.count}</span></a>
          ))}
        </nav>
      )}

      {posts.length === 0 ? (
        <p class="cmp-empty">No posts yet. Check back shortly.</p>
      ) : (
        <div class="blog-layout">
          <div class="blog-main">
            {lead && <PostCard post={lead} lead={true} />}
            {rest.length > 0 && (
              <div class="postlist">
                {rest.map((p) => <PostCard post={p} />)}
              </div>
            )}
          </div>
          <BlogSidebar />
        </div>
      )}
    </div>
  </section>
</Base>
