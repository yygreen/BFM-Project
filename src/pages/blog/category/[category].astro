---
import Base from "../../../layouts/Base.astro";
import PostCard from "../../../components/PostCard.astro";
import BlogSidebar from "../../../components/BlogSidebar.astro";
import { getPosts, getCategoryCounts, categorySlug, CATEGORY_BLURB } from "../../../lib/blog";

// Only categories that actually have posts get a page — an empty archive is
// a thin page Google will hold against the whole section.
export async function getStaticPaths() {
  const posts = await getPosts();
  const cats = await getCategoryCounts();
  return cats.map((c) => ({
    params: { category: c.slug },
    props: { name: c.name, posts: posts.filter((p) => p.data.category === c.name) },
  }));
}

const { name, posts } = Astro.props;
const blurb = CATEGORY_BLURB[name];

const jsonld = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${name} — buyflightmiles journal`,
  description: blurb,
  url: `https://buyflightmiles.com/blog/category/${categorySlug(name)}`,
};
---
<Base
  title={`${name} | Miles Journal | buyflightmiles`}
  description={blurb}
  slug={`blog/category/${categorySlug(name)}`}
  jsonld={jsonld}
>
  <section class="section">
    <div class="container">
      <a class="backlink" href="/blog">← All posts</a>
      <div class="section-head">
        <span class="kicker">{name}</span>
        <h2>{name}</h2>
        <p>{blurb}</p>
      </div>

      <div class="blog-layout">
        <div class="blog-main">
          <div class="postlist">
            {posts.map((p) => <PostCard post={p} />)}
          </div>
        </div>
        <BlogSidebar currentCategory={name} />
      </div>
    </div>
  </section>
</Base>
