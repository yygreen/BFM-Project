---
import Base from "../layouts/Base.astro";
import TrustStrip from "../components/TrustStrip.astro";
import CompareTable from "../components/CompareTable.astro";
import Faq from "../components/Faq.astro";
import Testimonials from "../components/Testimonials.astro";
import Emblem from "../components/Emblem.astro";
import { airlines } from "../data/airlines.js";

const jsonld = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "buyflightmiles",
  url: "https://buyflightmiles.com",
  description: "Buy airline miles for premium-cabin redemptions. Secure transfer, fast delivery.",
};
---
<Base
  title="Buy Airline Miles | Fast, Secure Delivery | buyflightmiles"
  description="Buy airline miles at a fraction of the price. Delta, United, American, Singapore and more — secure transfer, delivered within 24 hours, delivery guaranteed."
  jsonld={jsonld}
>
  <!-- HERO -->
  <section class="hero">
    <span class="blob" style="width:360px;height:360px;background:var(--acc-tint);top:-130px;left:-150px"></span>
    <span class="blob" style="width:320px;height:320px;background:var(--gold-tint);bottom:-150px;right:-110px"></span>
    <div class="container" style="position:relative;z-index:1">
      <div class="hero-grid">
        <div>
          <span class="kicker">Miles, delivered within hours</span>
          <h1>Fly business for the price of economy.</h1>
          <p class="sub">Buy the miles you're short across every major program. Secure transfer, delivered fast, and backed by a delivery guarantee — so booking the seat you actually want is finally within reach.</p>
          <div class="cta-row">
            <a class="btn btn-primary" href="#programs">View live pricing</a>
            <a class="btn btn-secondary" href="#how">How it works</a>
          </div>
          <div class="spec">
            <span><b>24h</b> delivery</span><span class="dot"></span>
            <span><b>99.9%</b> completion</span><span class="dot"></span>
            <span><b>4.8/5</b> rated</span>
          </div>
        </div>
        <div class="hero-art">
          <span class="deco-dots"></span>
          <div class="hero-scene">
            <svg viewBox="0 0 480 360" role="img" aria-label="An airplane following a route across the sky">
              <defs>
                <linearGradient id="skyg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#EAF1FB"/><stop offset="1" stop-color="#FBF3E4"/></linearGradient>
                <linearGradient id="planeg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#2159B8"/><stop offset="1" stop-color="#182A47"/></linearGradient>
              </defs>
              <rect width="480" height="360" fill="url(#skyg)"/>
              <circle cx="392" cy="84" r="42" fill="#F6D9A0" opacity="0.5"/>
              <circle cx="392" cy="84" r="27" fill="#E1A340"/>
              <g fill="#fff" opacity="0.92">
                <ellipse cx="118" cy="98" rx="48" ry="20"/><ellipse cx="150" cy="86" rx="30" ry="18"/>
                <ellipse cx="308" cy="156" rx="42" ry="16"/><ellipse cx="332" cy="150" rx="26" ry="13"/>
              </g>
              <path d="M68 302 Q232 62 432 210" fill="none" stroke="#2159B8" stroke-width="3" stroke-dasharray="1 12" stroke-linecap="round" opacity="0.7"/>
              <circle cx="68" cy="302" r="11" fill="#fff" stroke="#2159B8" stroke-width="4"/>
              <path d="M432 194 c-10 0-17 7-17 17 0 13 17 26 17 26 s17-13 17-26 c0-10-7-17-17-17z" fill="#182A47"/>
              <circle cx="432" cy="211" r="6" fill="#fff"/>
              <g transform="translate(236,118) rotate(24)">
                <path d="M0 -19 L6 -5 L30 8 L30 15 L4 10 L1 24 L10 29 L10 33 L-2 30 L-14 33 L-14 29 L-6 24 L-9 10 L-34 15 L-34 8 L-6 -5 Z" fill="url(#planeg)"/>
              </g>
              <g fill="#182A47" opacity="0.12">
                <rect x="38" y="318" width="10" height="26"/><rect x="52" y="308" width="12" height="36"/><rect x="68" y="322" width="9" height="22"/><rect x="82" y="314" width="10" height="30"/>
                <rect x="402" y="300" width="12" height="44"/><rect x="418" y="312" width="10" height="32"/><rect x="432" y="306" width="11" height="38"/><rect x="447" y="318" width="9" height="26"/>
              </g>
            </svg>
          </div>
          <div class="float-chip tr">
            <span class="fi" style="background:var(--gold)">★</span>
            <span>4.8 / 5<small>2,000+ reviews</small></span>
          </div>
          <div class="price-float">
            <p class="plabel">Featured · lowest price</p>
            <p class="pname">Singapore KrisFlyer</p>
            <div class="pf-price">1.8¢ <small>/ mile</small></div>
            <a class="btn btn-primary" href="/buy/krisflyer">Buy KrisFlyer</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROGRAMS -->
  <section class="section" id="programs">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Programs</span>
        <h2>Choose your program</h2>
        <p>Live, transparent pricing across every program we cover. Each links to full details and delivery times.</p>
      </div>
      <div class="grid">
        {airlines.map((a) => (
          <a class="gcard" href={`/buy/${a.slug}`}>
            <div class="top">
              <Emblem code={a.code} color={a.color} size={46} />
              {a.inStock
                ? <span class="badge badge-ok">In stock</span>
                : <span class="badge badge-warn">Limited</span>}
            </div>
            <div class="pname">{a.program}</div>
            <div class="plabel">{a.airline}</div>
            <div class="price" style="margin-top:14px">{a.pricePerMile}¢ <small>/ mile</small></div>
            <div class="meta"><span>{a.delivery.replace("Within ", "")}</span><span>{a.alliance}</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- COVERAGE BAND -->
  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="mapband">
        <svg viewBox="0 0 1000 300" role="img" aria-label="Global route network">
          <defs>
            <radialGradient id="mb" cx="50%" cy="0%" r="90%"><stop offset="0" stop-color="#22355A"/><stop offset="1" stop-color="#152540"/></radialGradient>
          </defs>
          <rect width="1000" height="300" fill="url(#mb)"/>
          <g fill="#3A4E72" opacity="0.5">
            {Array.from({ length: 130 }).map((_, i) => {
              const x = (i * 53) % 1000; const y = ((i * 37) % 210) + 20;
              return <circle cx={x} cy={y} r="1.6" />;
            })}
          </g>
          <g fill="none" stroke="#4E77C8" stroke-width="1.6" stroke-dasharray="1 9" stroke-linecap="round" opacity="0.85">
            <path d="M120 210 Q300 40 480 150"/>
            <path d="M480 150 Q640 250 820 110"/>
            <path d="M120 210 Q420 300 720 230"/>
            <path d="M300 90 Q520 20 760 70"/>
          </g>
          <g fill="#EAF1FB">
            <circle cx="120" cy="210" r="5"/><circle cx="480" cy="150" r="5"/><circle cx="820" cy="110" r="5"/><circle cx="720" cy="230" r="5"/><circle cx="300" cy="90" r="5"/><circle cx="760" cy="70" r="5"/>
          </g>
          <g transform="translate(560,118) rotate(30)"><path d="M0 -12 L4 -3 L19 5 L19 9 L3 6 L1 15 L6 19 L6 21 L-1 19 L-9 21 L-9 19 L-3 15 L-5 6 L-21 9 L-21 5 L-4 -3 Z" fill="#E1A340"/></g>
        </svg>
        <div class="emblem-row">
          {airlines.map((a) => (<Emblem code={a.code} color={a.color} size={42} />))}
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section tinted" id="how">
    <div class="container">
      <div class="section-head">
        <h2>Three steps to your miles</h2>
        <p>Simple, secure, and fast — most transfers complete within a day.</p>
      </div>
      <div class="steps">
        <div class="step">
          <span class="step-art a"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M7 8h10M7 12h7M7 16h4"/></svg></span>
          <div class="n">Step 01</div><h4>Select &amp; enter</h4><p>Pick the program, the amount, and your loyalty account number.</p>
        </div>
        <div class="step">
          <span class="step-art b"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="3"/><path d="M2 10h20M6 15h4"/></svg></span>
          <div class="n">Step 02</div><h4>Confirm &amp; pay</h4><p>Complete your order through our secure, off-site payment flow.</p>
        </div>
        <div class="step">
          <span class="step-art c"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20h20"/><path d="M4 15l16-4-1-4-5 1-6-6-2 1 3 6-5 1z"/></svg></span>
          <div class="n">Step 03</div><h4>Miles land</h4><p>They post to your account, usually within 24 hours. You're ready to book.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST -->
  <section class="section" id="trust">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Why trust us</span>
        <h2>Built for buyers who've been burned</h2>
        <p>Buying miles should feel as safe as any purchase. Here's what backs every order.</p>
      </div>
      <TrustStrip />
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section tinted">
    <div class="container">
      <div class="section-head center">
        <span class="kicker">In their words</span>
        <h2>Travellers who booked the seat they wanted</h2>
        <p>Real people, real redemptions — and miles that landed exactly when we said.</p>
      </div>
      <Testimonials />
    </div>
  </section>

  <!-- COMPARE -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Us vs. buying direct</h2>
        <p>Airlines sell their own miles at a steep markup. Here's the difference.</p>
      </div>
      <CompareTable program="miles" pricePerMile={1.8} />
    </div>
  </section>

  <!-- FAQ -->
  <section class="section tinted" id="faq">
    <div class="container" style="max-width:800px">
      <div class="section-head center">
        <h2>Questions, answered</h2>
      </div>
      <Faq delivery="24 hours" />
    </div>
  </section>
</Base>
