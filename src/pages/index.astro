---
import Base from "../layouts/Base.astro";
import TrustStrip from "../components/TrustStrip.astro";
import CompareTable from "../components/CompareTable.astro";
import Faq from "../components/Faq.astro";
import Testimonials from "../components/Testimonials.astro";
import Emblem from "../components/Emblem.astro";
import { airlines } from "../data/airlines.js";

const jsonld = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "buyflightmiles",
  url: "https://buyflightmiles.com",
  description: "Buy airline miles for premium-cabin redemptions. Secure transfer, fast delivery.",
};
---
<Base
  title="Buy Airline Miles | Fast, Secure Delivery | buyflightmiles"
  description="Buy airline miles at a fraction of the price. Delta, United, American, Singapore and more — secure transfer, delivered within 24 hours, delivery guaranteed."
  jsonld={jsonld}
>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div>
          <span class="kicker">Miles, delivered within hours</span>
          <h1>Fly business for the price of economy.</h1>
          <p class="sub">Buy the miles you're short across every major program. Secure transfer, delivered fast, backed by a delivery guarantee — the boarding pass most people never get to print.</p>
          <div class="cta-row">
            <a class="btn btn-primary" href="#programs">View live pricing</a>
            <a class="btn btn-secondary" href="#how">How it works</a>
          </div>
          <div class="spec">
            <span><b>24h</b> delivery</span><span class="dot"></span>
            <span><b>99.9%</b> completion</span><span class="dot"></span>
            <span><b>4.8/5</b> rated</span>
          </div>
        </div>
        <div class="hero-art">
          <span class="bp-stamp">Guaranteed</span>
          <div class="bpass">
            <div class="bpass-main">
              <div class="bp-top">
                <span class="bp-air">buy<span>flight</span>miles</span>
                <span class="bp-cls">BUSINESS</span>
              </div>
              <div class="bp-route">
                <div class="bp-city"><span class="bp-code">SIN</span><span class="bp-name">Singapore</span></div>
                <div class="bp-mid">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 16v-2l-8-5V3.5A1.5 1.5 0 0 0 11.5 2 1.5 1.5 0 0 0 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z"/></svg>
                </div>
                <div class="bp-city"><span class="bp-code">EWR</span><span class="bp-name">New York</span></div>
              </div>
              <div class="bp-grid">
                <div><span class="bp-lab">Program</span><span class="bp-val">KrisFlyer</span></div>
                <div><span class="bp-lab">Price</span><span class="bp-val sig">1.8¢/mi</span></div>
                <div><span class="bp-lab">Delivery</span><span class="bp-val">24 hrs</span></div>
              </div>
            </div>
            <div class="bpass-stub">
              <span class="bp-lab">Seat</span>
              <span class="bp-seat">2A</span>
              <span class="bp-lab" style="margin-top:10px">Cabin</span>
              <span class="bp-val">SUITES</span>
              <div class="bp-barcode"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROGRAMS -->
  <section class="section" id="programs">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Programs</span>
        <h2>Choose your program</h2>
        <p>Live, transparent pricing across every program we cover. Each links to full details and delivery times.</p>
      </div>
      <div class="grid">
        {airlines.map((a) => (
          <a class="gcard" href={`/buy/${a.slug}`}>
            <div class="top">
              <Emblem code={a.code} color={a.color} size={46} />
              {a.inStock
                ? <span class="badge badge-ok">In stock</span>
                : <span class="badge badge-warn">Limited</span>}
            </div>
            <div class="pname">{a.program}</div>
            <div class="plabel">{a.airline}</div>
            <div class="price" style="margin-top:14px">{a.pricePerMile}¢ <small>/ mile</small></div>
            <div class="meta"><span>{a.delivery.replace("Within ", "")}</span><span>{a.alliance}</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- DEPARTURES BOARD -->
  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Departures</span>
        <h2>Every major program, boarding now</h2>
        <p>Live rates across the programs we cover — pick the cabin you're headed for.</p>
      </div>
      <div class="depboard">
        <div class="dep-head">
          <span>Program</span><span>Alliance</span><span>Delivery</span><span>Price</span><span>Status</span>
        </div>
        {airlines.map((a) => (
          <a class="dep-row" href={`/buy/${a.slug}`}>
            <span class="dep-prog">
              <Emblem code={a.code} color={a.color} size={38} />
              <span>{a.program}<small>{a.airline}</small></span>
            </span>
            <span class="dep-cell hidem">{a.alliance}</span>
            <span class="dep-cell hidem">{a.delivery.replace("Within ", "")}</span>
            <span class="dep-price">{a.pricePerMile}¢</span>
            <span class={`dep-status ${a.inStock ? "" : "warn"}`}>{a.inStock ? "● Boarding" : "● Limited"}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section tinted" id="how">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Itinerary</span>
        <h2>Three steps to your miles</h2>
        <p>Simple, secure, and fast — most transfers complete within a day.</p>
      </div>
      <div class="steps">
        <div class="step">
          <span class="step-art"><span class="pin"></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M7 8h10M7 12h7M7 16h4"/></svg></span>
          <div class="n">Step 01</div><h4>Select &amp; enter</h4><p>Pick the program, the amount, and your loyalty account number.</p>
        </div>
        <div class="step">
          <span class="step-art"><span class="pin"></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="3"/><path d="M2 10h20M6 15h4"/></svg></span>
          <div class="n">Step 02</div><h4>Confirm &amp; pay</h4><p>Complete your order through our secure, off-site payment flow.</p>
        </div>
        <div class="step">
          <span class="step-art"><span class="pin"></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20h20"/><path d="M4 15l16-4-1-4-5 1-6-6-2 1 3 6-5 1z"/></svg></span>
          <div class="n">Step 03</div><h4>Miles land</h4><p>They post to your account, usually within 24 hours. You're ready to book.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST -->
  <section class="section" id="trust">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Why trust us</span>
        <h2>Built for buyers who've been burned</h2>
        <p>Buying miles should feel as safe as any purchase. Here's what backs every order.</p>
      </div>
      <TrustStrip />
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section tinted">
    <div class="container">
      <div class="section-head center">
        <span class="kicker">In their words</span>
        <h2>Travellers who booked the seat they wanted</h2>
        <p>Real people, real redemptions — and miles that landed exactly when we said.</p>
      </div>
      <Testimonials />
    </div>
  </section>

  <!-- COMPARE -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">The math</span>
        <h2>Us vs. buying direct</h2>
        <p>Airlines sell their own miles at a steep markup. Here's the difference.</p>
      </div>
      <CompareTable program="miles" pricePerMile={1.8} />
    </div>
  </section>

  <!-- FAQ -->
  <section class="section tinted" id="faq">
    <div class="container" style="max-width:800px">
      <div class="section-head center">
        <span class="kicker">Good to know</span>
        <h2>Questions, answered</h2>
      </div>
      <Faq delivery="24 hours" />
    </div>
  </section>
</Base>
