---
import Base from "../layouts/Base.astro";
import TrustStrip from "../components/TrustStrip.astro";
import CompareTable from "../components/CompareTable.astro";
import Faq from "../components/Faq.astro";
import Testimonials from "../components/Testimonials.astro";
import { airlines } from "../data/airlines.js";

const jsonld = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "buyflightmiles",
  url: "https://buyflightmiles.com",
  description: "Buy airline miles for premium-cabin redemptions. Secure transfer, fast delivery.",
};
---
<Base
  title="Buy Airline Miles | Fast, Secure Delivery | buyflightmiles"
  description="Buy airline miles at a fraction of the price. Delta, United, American, Singapore and more — secure transfer, delivered within 24 hours, delivery guaranteed."
  jsonld={jsonld}
>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div>
          <span class="kicker">Miles, delivered within hours</span>
          <h1>Fly business for the price of economy.</h1>
          <p class="sub">Buy the miles you're short across every major program. Secure transfer, delivered fast, and backed by a delivery guarantee — so booking the seat you actually want is finally within reach.</p>
          <div class="cta-row">
            <a class="btn btn-primary" href="#programs">View live pricing</a>
            <a class="btn btn-secondary" href="#how">How it works</a>
          </div>
          <div class="spec">
            <span><b>24h</b> delivery</span><span class="dot"></span>
            <span><b>99.9%</b> completion</span><span class="dot"></span>
            <span><b>4.8/5</b> rated</span>
          </div>
        </div>
        <div class="hero-art">
          <span class="halo"></span>
          <div class="art-card">
            <svg viewBox="0 0 400 190" role="img" aria-label="Route illustration" style="display:block;width:100%;height:auto;margin-bottom:20px">
              <defs>
                <linearGradient id="sky" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#EAF1FB"/><stop offset="1" stop-color="#FBF0DC"/>
                </linearGradient>
              </defs>
              <rect x="0" y="0" width="400" height="190" rx="14" fill="url(#sky)"/>
              <path d="M40 150 Q200 20 360 96" fill="none" stroke="#C4D8F2" stroke-width="2.5" stroke-dasharray="2 9" stroke-linecap="round"/>
              <circle cx="40" cy="150" r="7" fill="#fff" stroke="#2159B8" stroke-width="3"/>
              <circle cx="360" cy="96" r="7" fill="#2159B8"/>
              <g transform="translate(196,54) rotate(28)">
                <path d="M0 -13 L4 -4 L20 6 L20 11 L3 7 L1 15 L7 19 L7 22 L-1 20 L-9 22 L-9 19 L-3 15 L-5 7 L-22 11 L-22 6 L-6 -4 Z" fill="#182A47"/>
              </g>
            </svg>
            <p class="plabel" style="color:var(--text-3);font-size:13px;margin:0 0 4px">Featured · lowest price</p>
            <p class="pname" style="font-family:var(--display);font-weight:800;font-size:23px">Singapore KrisFlyer</p>
            <div class="price" style="display:flex;align-items:baseline;gap:6px;margin:10px 0 2px"><span class="num" style="font-family:var(--mono);font-size:40px;font-weight:600;color:var(--acc);line-height:1">1.8¢</span><span class="unit" style="color:var(--text-3)">/ mile</span></div>
            <p class="alt" style="color:var(--text-3);font-size:13px;margin-bottom:16px">≈ $18 per 1,000 miles</p>
            <a class="btn btn-primary" href="/buy/krisflyer" style="width:100%">Buy KrisFlyer</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROGRAMS -->
  <section class="section" id="programs">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Programs</span>
        <h2>Choose your program</h2>
        <p>Live, transparent pricing across every program we cover. Each links to full details and delivery times.</p>
      </div>
      <div class="grid">
        {airlines.map((a) => (
          <a class="gcard" href={`/buy/${a.slug}`}>
            <div class="top">
              <div>
                <div class="pname">{a.program}</div>
                <div class="plabel">{a.airline}</div>
              </div>
              {a.inStock
                ? <span class="badge badge-ok">In stock</span>
                : <span class="badge badge-warn">Limited</span>}
            </div>
            <div class="price">{a.pricePerMile}¢ <small>/ mile</small></div>
            <div class="meta"><span>{a.delivery.replace("Within ", "")}</span><span>{a.alliance}</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section tinted" id="how">
    <div class="container">
      <div class="section-head">
        <h2>Three steps to your miles</h2>
        <p>Simple, secure, and fast — most transfers complete within a day.</p>
      </div>
      <div class="steps">
        <div class="step">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9h10M7 13h6"/></svg></span>
          <div class="n">01</div><h4>Select &amp; enter</h4><p>Pick the program, the amount, and your loyalty account number.</p>
        </div>
        <div class="step">
          <span class="ic gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/></svg></span>
          <div class="n">02</div><h4>Confirm &amp; pay</h4><p>Complete your order through our secure, off-site payment flow.</p>
        </div>
        <div class="step">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
          <div class="n">03</div><h4>Miles land</h4><p>They post to your account, usually within 24 hours. You're ready to book.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST -->
  <section class="section" id="trust">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Why trust us</span>
        <h2>Built for buyers who've been burned</h2>
        <p>Buying miles should feel as safe as any purchase. Here's what backs every order.</p>
      </div>
      <TrustStrip />
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section tinted">
    <div class="container">
      <div class="section-head center">
        <span class="kicker">In their words</span>
        <h2>Travellers who booked the seat they wanted</h2>
        <p>Real people, real redemptions — and miles that landed exactly when we said.</p>
      </div>
      <Testimonials />
    </div>
  </section>

  <!-- COMPARE -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Us vs. buying direct</h2>
        <p>Airlines sell their own miles at a steep markup. Here's the difference.</p>
      </div>
      <CompareTable program="miles" pricePerMile={1.8} />
    </div>
  </section>

  <!-- FAQ -->
  <section class="section tinted" id="faq">
    <div class="container" style="max-width:800px">
      <div class="section-head center">
        <h2>Questions, answered</h2>
      </div>
      <Faq delivery="24 hours" />
    </div>
  </section>
</Base>
