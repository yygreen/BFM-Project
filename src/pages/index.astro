---
const base = (Astro.site ?? new URL("https://www.buyflightmiles.com")).origin;
import Base from "../layouts/Base.astro";
import TrustStrip from "../components/TrustStrip.astro";
import Trustpilot from "../components/Trustpilot.astro";
import Faq from "../components/Faq.astro";
import Testimonials from "../components/Testimonials.astro";
import Emblem from "../components/Emblem.astro";
import QuoteWidget from "../components/QuoteWidget.astro";
import StepArt from "../components/StepArt.astro";
import FlightSearch from "../components/FlightSearch.astro";
import { getCollection } from "astro:content";
import { site, live, realTestimonials, realReviews, flightSavings, flightSavingsHtml } from "../lib/site";

// alphabetical by carrier, matching the nav dropdown and the quote widget's
// selector — the grid is a lookup wall, and one site shouldn't have two orders
const airlines = (await getCollection("airlines"))
  .map((e) => ({ slug: e.id, ...e.data }))
  .sort((a, b) => a.airline.localeCompare(b.airline));

// Hero stats: only figures we can stand behind. Windows differ by program,
// so the hero says "fast" and each program page states its own number;
// rating/completion appear once the client verifies them.
//
// `fastest` is the shortest CONFIRMED window — sorted by hours, since the
// roster is ordered alphabetically and first-in-list is not fastest.
const fastest = airlines
  .filter((a) => a.deliveryVerified)
  .map((a) => a.delivery.replace("Within ", ""))
  .sort((a, b) => parseInt(a, 10) - parseInt(b, 10))[0];

const savings = flightSavings();
const savingsHtml = flightSavingsHtml();

const heroStats = [
  { n: "Fast", l: "delivery" },
  { n: String(airlines.length), l: "programs" },
  live(site.trust.completionRate) ? { n: `${site.trust.completionRate.value}%`, l: "completion" } : null,
].filter(Boolean);

// The rating closes the hero stat row — it's the strongest trust signal we
// have and it was sitting below the fold. Driven by reviews[] (the same source
// as the badge in the trust section) rather than the separate trust.rating
// field, so a published rating can never disagree with itself across the page.
const heroReview = realReviews[0] ?? null;
const stars = heroReview ? Math.round(heroReview.rating) : 0;
const starsOut = heroReview ? Math.round(heroReview.outOf) : 0;

const heroSub = site.guarantee.verified
  ? `Buy the miles you're short across every major program — secure transfer, delivered fast, and your payment protected until the miles arrive. The seat you actually want, finally within reach.`
  : "Buy the miles you're short across every major program — secure transfer, delivered fast, and your exact rate confirmed before you pay. The seat you actually want, finally within reach.";

// Meta description mirrors the on-page rules: no guarantee claim until it's
// confirmed, and the delivery window comes from real verified data.
const metaDescription = [
  "Buy airline miles at a fraction of the price.",
  "Delta, United, American, Singapore and more — secure transfer,",
  fastest ? `delivered within ${fastest.toLowerCase()},` : "delivered fast,",
  site.guarantee.verified ? `${site.guarantee.shortLabel} on every order.` : "your exact rate confirmed before you pay.",
].join(" ");

const jsonld = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "buyflightmiles",
  url: base,
  description: "Buy airline miles for premium-cabin redemptions. Secure transfer, fast delivery.",
};
---
<Base
  title="Buy Airline Miles | Fast, Secure Delivery | buyflightmiles"
  description={metaDescription}
  jsonld={jsonld}
>
  <!-- HERO -->
  <section class="hero">
    <span class="blob" style="width:400px;height:400px;background:rgba(37,64,255,.16);top:-150px;left:-150px"></span>
    <span class="blob" style="width:340px;height:340px;background:rgba(255,92,58,.15);bottom:-160px;right:-110px"></span>
    <div class="container">
      <div class="hero-grid">
        <div>
          <span class="kicker">Miles, delivered within hours</span>
          <!-- The keyword leads and the hook follows: the h1 was carrying the
               promise but not the phrase people search, while the title tag
               carried the phrase. Now they agree. -->
          <h1><span class="hl">Buy airline miles</span> and fly business class for less.</h1>
          <p class="sub">{heroSub}</p>
          <div class="cta-row">
            <a class="btn btn-primary" href="#programs">View live pricing</a>
            <a class="btn btn-secondary" href="#how">How it works</a>
          </div>
          {heroStats.length > 0 && (
            <div class="spec">
              {heroStats.map((s, i) => (
                <>
                  {i > 0 && <span class="dot"></span>}
                  <span><b>{s.n}</b> {s.l}</span>
                </>
              ))}
              {heroReview && (
                <span class="spec-revwrap">
                  <span class="dot"></span>
                  <a
                    class="spec-rev"
                    href={heroReview.url || undefined}
                    rel="nofollow noopener"
                    target={heroReview.url ? "_blank" : undefined}
                  >
                    <span class="spec-stars">
                      {"★".repeat(stars)}<span class="spec-stars-dim">{"★".repeat(Math.max(0, starsOut - stars))}</span>
                    </span>
                    <b>{heroReview.rating}</b>
                    <span class="spec-rev-plat">on {heroReview.platform}</span>
                  </a>
                </span>
              )}
            </div>
          )}
        </div>
        <div class="hero-art">
          <div class="hero-calc" id="quote">
            <QuoteWidget />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section" id="how">
    <div class="container">
      <div class="section-head">
        <span class="kicker">How it works</span>
        <h2>Three steps to the seat</h2>
        <p>No accounts to open, no software to learn. You keep control of the booking throughout.</p>
      </div>
      <div class="steps">
        <div class="step">
          <StepArt step="choose" />
          <div class="n">Step 01</div><h4>Choose</h4><p>Pick your program and how many miles you need. We come back with a firm price, free and with no obligation to take it.</p>
        </div>
        <div class="step">
          <StepArt step="pay" />
          <div class="n">Step 02</div><h4>Pay</h4><p>Approve the quote and pay off-site. Nothing is ever charged on this website, and we confirm by email once the transfer is on its way.</p>
        </div>
        <div class="step">
          <StepArt step="fly" />
          <div class="n">Step 03</div><h4>Fly</h4><p>Miles land in the account you already hold{fastest ? `, usually within ${fastest.toLowerCase()}` : ""}. You book directly with the airline, in your own name.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROGRAMS -->
  <section class="section tinted" id="programs">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Programs</span>
        <h2>Choose your program</h2>
        <p>Live, transparent pricing across every program we cover. Each links to full details and delivery times.</p>
      </div>
      <div class="grid">
        {airlines.map((a) => (
          <a class="gcard" href={`/buy/${a.slug}`}>
            <div class="top">
              <Emblem code={a.code} color={a.color} logo={a.logo} logoAlt={a.logoAlt} size={46} />
              {a.inStock
                ? <span class="badge badge-ok">In stock</span>
                : <span class="badge badge-warn">Limited</span>}
            </div>
            <!-- airline leads: the grid sorts A-Z by carrier, and the headline
                 must be the thing the sort is on or the order reads as random -->
            <div class="pname">{a.airline}</div>
            <div class="plabel">{a.program}</div>
            <div class="price" style="margin-top:14px">{a.priceVerified ? "" : "~"}{a.pricePerMile}¢ <small>/ mile</small></div>
            <div class="meta"><span>{a.deliveryVerified ? a.delivery.replace("Within ", "") : "fast delivery"}</span><span>{a.alliance}</span></div>
          </a>
        ))}
        <!-- catch-all for programs we don't list — a request, not a promise:
             availability gets confirmed in the quote, never asserted here -->
        <a class="gcard gcard-ask" href="/request">
          <div class="pname">Can't find your program?</div>
          <p class="askp">Not listed doesn't mean not available. Tell us the program and amount, and we'll check it and quote you.</p>
          <span class="askcta">Ask for a quote →</span>
        </a>
        <!-- The trade route out of a retail grid. Agents were reaching /agents
             only through the nav, which is the one place a visitor scanning
             prices isn't looking. Claims here are the ones /agents already
             makes; the volume threshold stays off it until confirmed. -->
        <a class="gcard gcard-ask gcard-partner" href="/agents">
          <span class="ask-tag">For agents &amp; brokers</span>
          <div class="pname">Booking for clients?</div>
          <p class="askp">Volume pricing on miles and on business or first class seats. Your client never sees us.</p>
          <span class="askcta">See partner access →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- AWARD FLIGHTS — the second thing we sell, placed after the roster
       because it answers the visitor the roster just lost: the one who wants
       the trip and doesn't want to work out which program opens it. -->
  <section class="section wash-warm" id="flights">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Award flights</span>
        <h2>Let us do the hunting</h2>
        {savings && (
          <p class="fs-save" set:html={savingsHtml} />
        )}
        <p>
          Working out which program opens which route is the fiddly part, and we do it
          all day. Give us the route and the dates, and we'll come back with a seat at
          the front of the plane and what it costs.
        </p>
      </div>
      <FlightSearch />
    </div>
  </section>

  <!-- TRUST + THE MATH — one section: what backs the order, then the numbers -->
  <section class="section" id="trust">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Why trust us</span>
        <h2>What backs every order</h2>
        <p>Miles or a finished ticket, the handling is the same and the risk sits with us. Here's exactly how your order works.</p>
      </div>

      <TrustStrip />
      <Trustpilot />
    </div>
  </section>

  <!-- TESTIMONIALS — hidden until real, client-verified quotes exist -->
  {realTestimonials.length > 0 && (
    <section class="section tinted">
      <div class="container">
        <div class="section-head center">
          <span class="kicker">In their words</span>
          <h2>Travellers who booked the seat they wanted</h2>
          <p>Real people, real redemptions — and miles that landed exactly when we said.</p>
        </div>
        <Testimonials />
      </div>
    </section>
  )}


  <!-- FAQ -->
  <section class="section tinted" id="faq">
    <div class="container">
      <div class="section-head center">
        <span class="kicker">Good to know</span>
        <h2>Questions about buying airline miles</h2>
      </div>
      <!-- the full set, and its FAQPage markup, live on /faq — the homepage
           shows the first few and sends the rest there -->
      <Faq delivery="24 hours" limit={5} jsonld={false} />
      <p style="text-align:center;margin-top:22px">
        <a class="btn btn-secondary" href="/faq">Read all questions</a>
      </p>
    </div>
  </section>
</Base>
