---
import Base from "../layouts/Base.astro";
import TrustStrip from "../components/TrustStrip.astro";
import { airlines } from "../data/airlines.js";

const coverage = airlines.slice(0, 8);
const check = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1F4FA3" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>';

const jsonld = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Wholesale airline miles and award ticket sourcing for travel agents",
  provider: { "@type": "Organization", name: "buyflightmiles" },
  serviceType: "Airline miles and award ticket sourcing",
  areaServed: "Worldwide",
  audience: { "@type": "BusinessAudience", audienceType: "Travel agents and brokers" },
};
---
<Base
  title="Wholesale Miles & Award Tickets for Travel Agents | buyflightmiles"
  description="Partner pricing on airline miles plus business- and first-class award tickets sourced to spec, for travel agents and brokers. Fast, guaranteed, white-label."
  slug="agents"
  jsonld={jsonld}
>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div>
          <span class="kicker">For agents &amp; brokers</span>
          <h1>Wholesale miles and award tickets for travel agents.</h1>
          <p class="sub">Partner pricing, dependable delivery, and business- and first-class seats sourced to your spec. Your clients get the trip — they never see us.</p>
          <div class="cta-row">
            <a class="btn btn-primary" href="#apply">Apply for partner access</a>
            <a class="btn btn-secondary" href="#how">How it works</a>
          </div>
          <div class="spec">
            <span><b>24h</b> delivery</span><span>·</span>
            <span><b>Every</b> major program</span><span>·</span>
            <span><b>White-label</b></span>
          </div>
        </div>
        <div>
          <div class="tbox" style="padding:24px">
            <p class="lab" style="margin-bottom:14px">Partner snapshot</p>
            <ul class="checklist">
              <li><Fragment set:html={check} /> Partner rates that scale with volume</li>
              <li><Fragment set:html={check} /> Miles across every major program</li>
              <li><Fragment set:html={check} /> Business &amp; first tickets, sourced to spec</li>
              <li><Fragment set:html={check} /> Delivered fast, backed by guarantee</li>
              <li><Fragment set:html={check} /> White-label — the relationship stays yours</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY AGENTS -->
  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="section-head">
        <h2>Why agents work with us</h2>
        <p>Built for professionals who resell to clients and can't afford a miss.</p>
      </div>
      <div class="uses">
        <div class="use"><h4>Partner pricing</h4><p>Per-mile rates that scale with volume, so your margin holds.</p></div>
        <div class="use"><h4>Dependable fulfillment</h4><p>Fast, guaranteed delivery your client's itinerary can rely on.</p></div>
        <div class="use"><h4>Premium seat sourcing</h4><p>We find specific business- and first-class award space via award arbitrage.</p></div>
        <div class="use"><h4>White-label &amp; discreet</h4><p>We stay behind the scenes — the client relationship stays yours.</p></div>
      </div>
    </div>
  </section>

  <!-- TWO SERVICES -->
  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="section-head">
        <h2>Two ways we help you deliver</h2>
        <p>Hand off as much or as little as you want.</p>
      </div>
      <div class="cols">
        <div class="tbox" style="padding:24px">
          <p class="pname" style="font-size:19px">Miles top-ups</p>
          <p style="color:var(--text-2);font-size:14px;line-height:1.6;margin-top:8px">Buy miles across every major program to complete your client's redemption yourself. Delivered in hours, at partner rates.</p>
        </div>
        <div class="tbox" style="padding:24px">
          <p class="pname" style="font-size:19px">Booked award tickets</p>
          <p style="color:var(--text-2);font-size:14px;line-height:1.6;margin-top:8px">Prefer not to handle the booking? Send the route, cabin, and dates — we source the business- or first-class award seat and hand you a confirmed ticket.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section" id="how" style="padding-top:0">
    <div class="container">
      <div class="section-head"><h2>How the partnership works</h2></div>
      <div class="steps">
        <div class="step"><div class="n">01</div><h4>Apply</h4><p>Tell us about your business and typical volume.</p></div>
        <div class="step"><div class="n">02</div><h4>Get partner pricing</h4><p>We set you up with rates and a direct contact.</p></div>
        <div class="step"><div class="n">03</div><h4>Submit requests</h4><p>Send miles top-ups or specific ticket requests, any time.</p></div>
        <div class="step"><div class="n">04</div><h4>We source &amp; deliver</h4><p>Miles land or tickets arrive — fast, and guaranteed.</p></div>
      </div>
    </div>
  </section>

  <!-- COVERAGE -->
  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="section-head"><h2>Every major program</h2><p>Top up any of these for your clients — and more on request.</p></div>
      <div class="related">
        {coverage.map((a) => (<a href={`/buy/${a.slug}`}>{a.airline} {a.program}</a>))}
      </div>
    </div>
  </section>

  <!-- TRUST -->
  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="section-head"><h2>Your reputation rides on every trip</h2><p>So does ours. Here's what backs every order.</p></div>
      <TrustStrip />
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="padding-top:0">
    <div class="container" style="max-width:760px">
      <div class="section-head"><h2>Partner questions</h2></div>
      <details class="faq" open><summary>How does partner pricing work?<span class="mk">+</span></summary><div class="ans">Rates scale with volume. You get a set per-mile price and a direct contact — reach out and we'll quote based on what you typically move.</div></details>
      <details class="faq"><summary>Can you source a specific business-class seat?<span class="mk">+</span></summary><div class="ans">Yes. Send the route, cabin, and dates, and we find the award space and book it — you receive a confirmed ticket to pass to your client.</div></details>
      <details class="faq"><summary>How fast is delivery?<span class="mk">+</span></summary><div class="ans">Most miles land within 24 hours. Sourced tickets depend on availability; we confirm realistic timelines before you commit.</div></details>
      <details class="faq"><summary>Is it white-label?<span class="mk">+</span></summary><div class="ans">Yes. We stay behind the scenes — your client deals only with you.</div></details>
      <details class="faq"><summary>What payment methods and terms do you offer?<span class="mk">+</span></summary><div class="ans">[Replace with your actual accepted methods and any partner terms.]</div></details>
    </div>
  </section>

  <!-- APPLY -->
  <section class="section" id="apply" style="padding-top:0">
    <div class="container" style="max-width:640px">
      <div class="section-head" style="text-align:center;margin:0 auto 24px">
        <h2>Apply for partner access</h2>
        <p>Tell us about your business and we'll set you up with pricing and a direct contact.</p>
      </div>
      <form class="formcard" id="partner-form">
        <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
        <input type="hidden" name="subject" value="New partner application — buyflightmiles" />
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />
        <div class="form-grid">
          <div class="field"><label for="name">Name *</label><input id="name" name="name" type="text" required /></div>
          <div class="field"><label for="agency">Agency / company *</label><input id="agency" name="agency" type="text" required /></div>
          <div class="field"><label for="email">Work email *</label><input id="email" name="email" type="email" required /></div>
          <div class="field"><label for="phone">Phone</label><input id="phone" name="phone" type="tel" /></div>
          <div class="field"><label for="iata">IATA number</label><input id="iata" name="iata" type="text" /></div>
          <div class="field"><label for="volume">Typical monthly volume</label><select id="volume" name="volume"><option>Under $5,000</option><option>$5,000–$25,000</option><option>$25,000–$100,000</option><option>$100,000+</option></select></div>
        </div>
        <div class="field" style="margin-bottom:4px"><label for="message">What are you looking for?</label><textarea id="message" name="message" rows="4" placeholder="Programs of interest, typical routes and cabins, anything else."></textarea></div>
        <button type="submit" class="btn btn-primary" id="partner-submit" style="width:100%;margin-top:14px">Submit application</button>
        <p class="form-msg" id="partner-msg" hidden></p>
      </form>
      <p style="color:var(--text-3);font-size:12px;font-family:var(--mono);text-align:center;margin-top:12px">TODO: set your Web3Forms access key (register it with the destination Gmail).</p>
    </div>
  </section>

  <script>
    const form = document.getElementById("partner-form");
    const msg = document.getElementById("partner-msg");
    const btn = document.getElementById("partner-submit");
    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const label = btn.textContent;
        btn.disabled = true;
        btn.textContent = "Sending…";
        msg.hidden = true;
        try {
          const data = Object.fromEntries(new FormData(form));
          const res = await fetch("https://api.web3forms.com/submit", {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify(data),
          });
          const json = await res.json();
          if (json.success) {
            form.reset();
            msg.textContent = "Thanks — your application is in. We'll be in touch shortly.";
            msg.className = "form-msg ok";
          } else {
            msg.textContent = json.message || "Something went wrong. Please email us instead.";
            msg.className = "form-msg err";
          }
        } catch (err) {
          msg.textContent = "Network error. Please try again, or email us directly.";
          msg.className = "form-msg err";
        } finally {
          msg.hidden = false;
          btn.disabled = false;
          btn.textContent = label;
        }
      });
    }
  </script>
</Base>
