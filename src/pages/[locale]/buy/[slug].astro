---
// Localized program landing pages, one route for every language.
//
// Generated only for entries carrying an i18n block, so adding a language
// market is data entry: an entry in src/lib/locales.ts for the chrome, and an
// i18n.<locale> block per program for the marketing copy. The old WordPress
// site ranks with /qatar-airways-ar; this is that surface, generalized.
//
// Held to the same honesty rules as the English pages: no invented fares,
// payment stays off-site, unverified claims don't render.
//
// v1 scope, deliberately: the header and footer chrome stays English and the
// CTA leads to the English quote flow. The page content is in the language.
//
// German is excluded here because it has its own richer route file. See the
// `bespoke` flag in the registry.
import Base from "../../../layouts/Base.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import QuoteWidget from "../../../components/QuoteWidget.astro";
import SavingsTool from "../../../components/SavingsTool.astro";
import { getCollection } from "astro:content";
import { realReviews, yearsTrading } from "../../../lib/site";
import { LOCALES, GENERIC_LOCALES, EN_FLAG } from "../../../lib/locales";
import { fxFor, fxDate, moneyTpl, moneySymbol } from "../../../lib/fx";

const rev = realReviews[0];
const years = yearsTrading();

export async function getStaticPaths() {
  const airlines = (await getCollection("airlines")).map((e) => ({ slug: e.id, ...e.data }));
  return GENERIC_LOCALES.flatMap((locale) =>
    airlines
      .filter((a) => a.i18n?.[locale])
      .map((a) => ({
        params: { locale, slug: a.slug },
        props: { a, t: a.i18n[locale], locale },
      })),
  );
}

const { a, t, locale } = Astro.props;
const L = LOCALES[locale];
const P = L.page;
// Delivery reads "Within 48 hours" in the data; the localized page needs the
// number without the English preposition, since each language puts its own
// wording in `deliveredIn`.
// "Within 48 hours" in the data becomes "48 <unit>" in the page's language.
// Leaving it English was the one place a translated hero still read as one.
const deliveryValue = a.delivery.replace("Within ", "").replace(/\bhours?\b/, L.page.hours);
// lang/hreflang can differ from the URL segment, e.g. /zh-tw/ tagged zh-TW
const htmlLang = L.htmlLang ?? locale;

// Prices are charged in dollars; the local figure beside them is a reading
// aid. It renders only when we hold a rate, and it always names its source
// and, where the source has one, its date. A program may override the
// locale's currency: the Arabic pages sell into Qatar and the UAE.
const currency = t.currency ?? L.fx?.currency ?? null;
const fx = currency ? fxFor(currency) : null;
const showFx = Boolean(L.fx && fx);
const stamp = fx?.date ? fxDate(fx.date, L.numLocale) : "";
const fill = (s: string) => s.replaceAll("{d}", stamp);

const widget = {
  ...L.widget,
  ...(showFx
    ? { fxRate: fx!.rate, fxMoney: moneyTpl(currency!), fxNote: fill(L.fx!.note) }
    : {}),
};
// The savings tool asks for a cash fare, so its input has to say which
// currency it wants. Without a rate it keeps asking for dollars.
const savings = {
  ...L.savings,
  ...(L.savings.fareLabel
    ? { fareLabel: L.savings.fareLabel.replace("{cur}", showFx ? moneySymbol(currency!) : "$") }
    : {}),
  ...(showFx
    ? { fxRate: fx!.rate, fxMoney: moneyTpl(currency!), fxFoot: fill(L.fx!.foot) }
    : {}),
};
---
<Base
  title={t.metaTitle}
  description={t.metaDescription}
  slug={`${locale}/buy/${a.slug}`}
  lang={htmlLang}
  alternates={[{ hreflang: "en", slug: `buy/${a.slug}` }]}
>
  <div dir={L.dir} lang={htmlLang}>
    <section class="hero">
      <div class="container">
        <div class="hero-grid top">
          <div>
            <Breadcrumbs rtl={L.dir === "rtl"} items={[
              { label: P.home, href: "/" },
              { label: P.programs, href: "/#programs" },
              { label: t.heroHeadline },
            ]} />
            <span class="kicker">{a.alliance}</span>
            <a class="lang-toggle" href={`/buy/${a.slug}`} lang="en" hreflang="en">
              <span class="lang-flag" aria-hidden="true">{EN_FLAG}</span>English
            </a>
            <h1>{t.heroHeadline}</h1>
            <p class="sub">{t.heroSub}</p>
            <div class="cta-row">
              <a class="btn btn-primary" href="#quote">{t.ctaLabel}</a>
            </div>
            <!-- the same three slots as the English hero, each falling back to
                 an always-true claim when its figure isn't confirmed, so the
                 row never invents a number in any language -->
            <div class="spec">
              {rev ? (
                <span class="spec-it">
                  <svg viewBox="0 0 24 24" fill="#F5A623" stroke="none" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  <b>{rev.rating}/{rev.outOf}</b>&nbsp;{P.on} {rev.platform}
                </span>
              ) : (
                <span class="spec-it">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  {P.freeQuote}
                </span>
              )}
              <span class="spec-it">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {P.deliveredIn} <b>{deliveryValue}</b>
              </span>
              {years !== null ? (
                <span class="spec-it">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
                  <b>{years}+</b>&nbsp;{P.yearsIn}
                </span>
              ) : (
                <span class="spec-it">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                  {P.ratePreConfirmed}
                </span>
              )}
            </div>
          </div>
          <div class="hero-art">
            <div class="hero-calc" id="quote">
              <QuoteWidget defaultSlug={a.slug} locked heading={P.quoteHeading} sub={P.quoteSub} labels={widget} />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>{P.howItWorks}</h2>
        </div>
        <div class="steps" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr))">
          {t.steps.map((s, i) => (
            <div class="step">
              <div class="n">0{i + 1}</div>
              <h4>{s.title}</h4>
              <p>{s.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* The value section, mirroring the English page: the redemptions worth
        buying for, and beside them the tool that tests any of it against a
        real fare. This was missing from every translated page, which left
        them the marketing without the one thing that argues for the price. */}
    {t.uses && t.uses.length > 0 && (
      <section class="section wash-cool" id="uses">
        <div class="container">
          <div class="section-head">
            <h2>{P.bestUses}</h2>
            <p>{P.bestUsesSub}</p>
          </div>
          <div class="value-split">
            <div class="value-lad">
              <div class="vtier">
                <div class="vtier-head">
                  <span class="vchip v1">{P.greatValue}</span>
                  <span class="vtier-note">{P.greatValueNote}</span>
                </div>
                <div class="uses">
                  {t.uses.map((u) => (
                    <div class="use">
                      <h4>{u.title}</h4>
                      <p>{u.desc}</p>
                    </div>
                  ))}
                </div>
              </div>
            </div>
            <div class="value-tool">
              <div class="worth-sub" id="worth">
                <h3>{P.worthHead}</h3>
                <p>{P.worthSub}</p>
              </div>
              <SavingsTool
                program={a.program}
                rate={a.pricePerMile}
                verified={a.priceVerified}
                labels={savings}
              />
            </div>
          </div>
        </div>
      </section>
    )}

    {t.points && t.points.length > 0 && (
      <section class="section wash-cool">
        <div class="container">
          <div class="section-head">
            <h2>{P.whyUs}</h2>
          </div>
          <div class="vgood">
            {t.points.map((p) => <div class="vitem">{p}</div>)}
          </div>
        </div>
      </section>
    )}

    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>{P.faq}</h2>
        </div>
        {t.faq.map((f) => (
          <details class="faq-item" style="background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-card);padding:18px 22px;margin-bottom:12px">
            <summary style="font-weight:600;cursor:pointer">{f.q}</summary>
            <p style="color:var(--text-2);margin:12px 0 0">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="section wash-cool">
      <div class="container ctaband">
        <div>
          <h3>{P.ctaHead}</h3>
          <p>{P.ctaSub}</p>
        </div>
        <a class="btn btn-primary" href="#quote">{t.ctaLabel}</a>
      </div>
    </section>
  </div>
</Base>
