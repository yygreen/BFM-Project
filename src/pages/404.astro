---
// The not-found page. Vercel serves dist/404.html with a real 404 status for
// any URL that matches neither a page nor a redirect, so this is the screen
// an old WordPress link lands on when it misses the redirect map — the worst
// possible moment to show a hosting company's error card on a site whose
// whole pitch is trust.
//
// Drawn in the brand's route language: the main line still runs level and
// arrives on the destination ring — the site is on course — while a dashed
// coral spur branches off and dead-ends at the 404 marker, which is where
// the visitor is standing. The way back is the same line.
//
// The program pills exist for the lost-link case specifically: someone who
// followed a stale URL to a program page can usually see their airline in
// this list and recover in one tap, instead of restarting from the homepage.
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const programs = (await getCollection("airlines"))
  .map((e) => ({ slug: e.id, ...e.data }))
  .sort((a, b) => a.airline.localeCompare(b.airline));
---
<Base
  title="Page not found | buyflightmiles"
  description="That page isn't here. The programs, pricing and blog all are."
  slug="404"
  robots="noindex"
>
  <section class="section nf">
    <div class="container">
      <!-- Full container width: the viewBox is drawn at ~page width rather
           than scaled up from a smaller one, so the stroke weights render at
           the same optical size as the step art's route. Below 720px this
           drawing would shrink to a hairline with an unreadable marker, so a
           compact variant drawn for phone width takes over there. -->
      <svg class="nf-art nf-art-wide" viewBox="0 0 1160 170" role="img" aria-label="A route arriving at its destination, with one dashed spur that dead-ends at a 404 marker">
        <!-- the route, still on course: level line onto the logo's ring -->
        <path class="nf-line" d="M1.25 44H1140" />
        <circle class="nf-ring" cx="11.25" cy="44" r="10" />
        <circle class="nf-dot" cx="11.25" cy="44" r="4.5" />
        <circle class="nf-ring" cx="430" cy="44" r="10" />
        <circle class="nf-dot" cx="430" cy="44" r="4.5" />
        <circle class="nf-dest" cx="1150" cy="44" r="7.25" />
        <!-- the spur: leaves the route at the second waypoint, dashed like a
             tether because it was never a scheduled leg, and dead-ends on the
             page's centreline, directly above the centred headline below -->
        <path class="nf-spur" d="M430 56C430 96 500 92 526 104S553 132 553 134" />
        <circle class="nf-x" cx="559" cy="140" r="4.5" />
        <text class="nf-tag" x="578" y="145">404</text>
      </svg>
      <svg class="nf-art nf-art-compact" viewBox="0 0 360 130" role="img" aria-label="A route arriving at its destination, with one dashed spur that dead-ends at a 404 marker">
        <path class="nf-line" d="M1.25 32H336" />
        <circle class="nf-ring" cx="11.25" cy="32" r="10" />
        <circle class="nf-dot" cx="11.25" cy="32" r="4.5" />
        <circle class="nf-ring" cx="95" cy="32" r="10" />
        <circle class="nf-dot" cx="95" cy="32" r="4.5" />
        <circle class="nf-dest" cx="346" cy="32" r="7.25" />
        <path class="nf-spur" d="M95 44C95 72 135 70 148 78S158 92 158 94" />
        <circle class="nf-x" cx="162" cy="100" r="4.5" />
        <text class="nf-tag" x="177" y="105">404</text>
      </svg>

      <!-- centred under the spur's 404 marker; the drawing carries the
           status code, so no kicker pill repeats it -->
      <div class="nf-intro">
        <h1>This one's off the route.</h1>
        <p class="sub nf-sub">
          The page you're after isn't here. The address may have a typo, or it
          belongs to an older version of this site. The rest of the site is
          still on course, and everything worth reaching is one tap below.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="/">Back to the homepage</a>
          <a class="btn btn-secondary" href="/#programs">View live pricing</a>
        </div>
      </div>

      <h2 class="nf-h2">Looking for a program?</h2>
      <nav class="nf-pills" aria-label="All programs">
        {programs.map((p) => (
          <a class="nf-pill" href={`/buy/${p.slug}`}>{p.airline}</a>
        ))}
      </nav>

      {/* one line on purpose: Astro collapses the whitespace between text
          and a link that starts a new source line, gluing the words together */}
      <p class="nf-more">Or head for the <a href="/blog">blog</a>, the <a href="/faq">questions people ask</a>, or <a href="/request">ask us for a quote</a>. If a page moved, we can point you straight at it: <a href="/contact">talk to us</a>.</p>
    </div>
  </section>
</Base>

<style>
  .nf { text-align:left; }
  .nf-art { display:block; width:100%; height:auto; overflow:visible; margin:8px 0 34px; }
  .nf-art-compact { display:none; }
  @media (max-width:720px){
    .nf-art-wide { display:none; }
    .nf-art-compact { display:block; }
  }
  .nf-line { fill:none; stroke:var(--cobalt); stroke-width:2.5; stroke-linecap:round; }
  .nf-ring { fill:none; stroke:var(--cobalt-line); stroke-width:2.5; }
  .nf-dot  { fill:var(--coral); }
  .nf-dest { fill:none; stroke:var(--cobalt); stroke-width:5.5; }
  .nf-spur { fill:none; stroke:var(--coral); stroke-width:2.5; stroke-linecap:round; stroke-dasharray:1 7; }
  .nf-x    { fill:none; stroke:var(--coral); stroke-width:2.5; }
  .nf-tag  { font-family:var(--mono); font-size:13px; font-weight:600; fill:var(--coral); }

  .nf-intro { text-align:center; }
  /* the stylesheet only lays out .cta-row inside .hero; out here the row
     needs its own flex and gap or the two pills sit flush together */
  .nf-intro .cta-row { display:flex; gap:12px; flex-wrap:wrap; justify-content:center; }
  .nf-sub { max-width:640px; margin-left:auto; margin-right:auto; }
  .nf-h2 { font-size:20px; margin:44px 0 16px; }
  .nf-pills { display:flex; flex-wrap:wrap; gap:8px; }
  .nf-pill {
    display:inline-flex; align-items:center;
    font-family:var(--display); font-weight:600; font-size:13.5px;
    color:var(--text-1); text-decoration:none;
    background:var(--raised); border:1px solid var(--line-2);
    border-radius:var(--radius-pill); padding:7px 14px;
    transition:border-color .15s ease, background .15s ease;
  }
  .nf-pill:hover { border-color:var(--cobalt); background:var(--cobalt-tint); }
  .nf-more { margin-top:28px; color:var(--text-2); }
  .nf-more a { color:var(--cobalt); }
</style>
