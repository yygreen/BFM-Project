---
/**
 * Channel verification: "is this really you?"
 *
 * A ranking site in a scam-wary market gets impersonated. The usual pattern is
 * someone messaging a buyer as us, from a handle we have never used, asking for
 * payment. The defence is a page we can point at: here is every channel we use,
 * spelled out, and here is the list of things we will never do.
 *
 * Everything on it is data-driven from site.json via officialChannels(), so the
 * footer, the contact page and this list cannot drift apart. An unconfirmed
 * handle is omitted rather than published as official, since a wrong "official"
 * channel is the exact harm this page exists to prevent.
 *
 * Deliberately indexed. Someone checking whether we are real should be able to
 * find this from a search, and it is the page a buyer is sent to mid-doubt.
 */
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { officialChannels, site } from "../lib/site";

const channels = officialChannels();
const host = new URL(Astro.site ?? "https://buyflightmiles.com").host;

// Every one of these is already true and already stated elsewhere on the site;
// this page is where they are collected so a worried visitor reads them at once.
const never = [
  {
    t: "We never ask for your password",
    d: "A transfer needs your membership number and the name on the account. Nothing else. Anyone asking you to hand over loyalty account credentials is not us, whatever the message says.",
  },
  {
    t: "We never take payment on this website",
    d: `Nothing is charged anywhere on ${host}. There is no checkout, no card field and no payment page. A page that looks like ours and asks for card details is not ours.`,
  },
  {
    t: "We never message you first asking for money",
    d: "Payment details follow a quote you asked us for. An unsolicited message quoting a price and pushing you to pay quickly is the impersonation pattern, not us.",
  },
  {
    t: "We never rush you",
    d: "Your quote states the rate and the delivery window before you agree to anything. Urgency is the oldest pressure tactic there is, and we have no reason to use it.",
  },
];
---
<Base
  title="Verify you're talking to buyflightmiles"
  description="Every channel we actually use, listed in one place, and the four things we will never do. Check any message claiming to be from us against this page before you pay anyone."
  slug="verify"
>
  <section class="section">
    <div class="container" style="max-width:820px">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Verify our channels" }]} />
      <span class="kicker">Security</span>
      <h1>Is this really us?</h1>
      <p class="sub">
        Miles resale attracts impersonators, and the usual move is a message from
        a handle we have never used. Everything we actually use is listed below.
        If a message reaches you from anywhere else, it is not from us.
      </p>

      <h2>The only channels we use</h2>
      {channels.length ? (
        <>
          <p>
            Compare what you were contacted from against this list, character by
            character. Lookalike handles are the whole trick: a swapped letter, an
            extra digit, a different country code.
          </p>
          <div class="vfy-list">
            {channels.map((c) => (
              <a
                class="vfy-row"
                href={c.href}
                rel={c.external ? "noopener" : undefined}
                target={c.external ? "_blank" : undefined}
              >
                <span class="vfy-k">{c.label}</span>
                <b class="vfy-v">{c.value}</b>
              </a>
            ))}
          </div>
          <p class="vfy-note">
            Our website is <b>{host}</b> and nothing else. Check the address bar
            before you type anything into a page that looks like ours.
          </p>
        </>
      ) : (
        /* Channels unconfirmed: say so rather than publish a list that might be
           wrong. A wrong "official" number is worse than no page at all. */
        <p>
          Our contact channels are being confirmed and will be listed here. Until
          then, reach us through the <a href="/contact">contact page</a> on this
          website and treat any other approach with caution.
        </p>
      )}

      <h2>Four things we will never do</h2>
      <div class="vfy-never">
        {never.map((n) => (
          <div class="vfy-item">
            <h3>{n.t}</h3>
            <p>{n.d}</p>
          </div>
        ))}
      </div>

      <h2>If someone contacts you claiming to be us</h2>
      <ol>
        <li><b>Do not pay.</b> Payments by transfer are not reversible, which is exactly why impersonators ask for them.</li>
        <li><b>Check the channel against the list above.</b> Not the display name, which anyone can set. The number or the address itself.</li>
        <li>
          <b>Tell us.</b> Reach us on a channel from this page and send us what you
          received. It helps us get the account taken down, and it costs you nothing.
        </li>
      </ol>

      <h2>Before you pay anyone in this market</h2>
      <p>
        This applies to us as much as to anyone else, and we would rather you did
        it than didn't. We wrote up the checks worth running on any miles seller,
        including the questions we would want you to ask us: <a href="/blog/how-to-check-a-miles-seller-is-legitimate">how to check a miles seller is legitimate</a>.
      </p>
      {site.guarantee.verified && (
        <p>{site.guarantee.summary} {site.guarantee.policy}</p>
      )}
    </div>
  </section>
</Base>

<style>
  .vfy-list { display:grid; gap:10px; margin:18px 0 14px; }
  .vfy-row { display:flex; align-items:center; justify-content:space-between; gap:16px;
    background:var(--surface); border:1px solid var(--line); border-radius:var(--radius-card);
    padding:14px 18px; text-decoration:none; }
  .vfy-row:hover { border-color:var(--cobalt-line); }
  .vfy-k { color:var(--text-3); font-size:13px; text-transform:uppercase; letter-spacing:.06em;
    font-family:var(--display); font-weight:800; }
  .vfy-v { font-family:var(--mono); font-size:15.5px; color:var(--ink); word-break:break-all; text-align:right; }
  .vfy-note { color:var(--text-2); font-size:14.5px; }
  .vfy-never { display:grid; gap:14px; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); margin-top:18px; }
  .vfy-item { background:var(--raised); border-radius:var(--radius-card); padding:16px 18px; }
  .vfy-item h3 { margin:0 0 6px; font-size:16px; color:var(--text-1); }
  .vfy-item p { margin:0; color:var(--text-2); font-size:14.5px; line-height:1.6; }
</style>
