---
// Trust figures come from src/data/site.json. A stat renders ONLY when the
// client has confirmed it (verified: true) — unverified numbers are dropped
// rather than shipped, because inventing trust stats is the one thing this
// site must never do. The structural tiles below are true by design (the
// quote-before-you-pay flow, off-site payment) so the strip is never empty.
import { site, live, realReviews, yearsTrading } from "../lib/site";
import { getCollection } from "astro:content";

const r = site.trust.rating;
const ratingLive = r.verified && r.value !== null;

// structural facts, true by construction — no client confirmation needed
const all = (await getCollection("airlines")).map((e) => e.data);
const programCount = all.length;
// derive the alliance list — four of the US carriers belong to none
const alliances = [...new Set(all.map((a) => a.alliance))].filter((x) => x !== "Independent");
const coverageCap = alliances.length
  ? `Across ${alliances.slice(0, -1).join(", ")}${alliances.length > 1 ? " and " : ""}${alliances[alliances.length - 1]}${all.some((a) => a.alliance === "Independent") ? ", plus independent carriers" : ""}`
  : "Across every programme we cover";
const years = yearsTrading();

// bottom spec strip — only the verified figures
const specs = [
  live(site.trust.completionRate) ? { n: `${site.trust.completionRate.value}%`, l: "completion" } : null,
  live(site.trust.accountLocks) ? { n: `${site.trust.accountLocks.value}`, l: "account locks" } : null,
  live(site.trust.supportHours) ? { n: `${site.trust.supportHours.value}`, l: "support" } : null,
].filter(Boolean);
---
<div class="trust-grid">
  {ratingLive && (
    <div class="tbox">
      <p class="lab">Rating</p>
      <div class="stars">★★★★★</div>
      <div class="cap">
        <b style="color:var(--text-1);font-family:var(--mono)">{r.value}/{r.outOf}</b>
        {r.reviewCount && r.source ? ` · ${r.reviewCount.toLocaleString("en-US")}+ ${r.source} reviews` : r.source ? ` · ${r.source}` : ""}
      </div>
    </div>
  )}

  {live(site.trust.transfersCompleted) && (
    <div class="tbox">
      <p class="lab">Delivered</p>
      <div class="big">{Number(site.trust.transfersCompleted.value).toLocaleString("en-US")}+</div>
      <div class="cap">transfers completed</div>
    </div>
  )}

  {site.guarantee.verified && (
    <div class="tbox">
      <p class="lab">Guarantee</p>
      <div class="chip-row">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2540FF" stroke-width="2"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
        Delivery guarantee
      </div>
      <div class="cap">{site.guarantee.summary}</div>
    </div>
  )}

  {years !== null && (
    <div class="tbox">
      <p class="lab">Track record</p>
      <div class="big">{years}+</div>
      <div class="cap">years buying and transferring miles</div>
    </div>
  )}

  <!-- structural: true by design, no client confirmation needed -->
  <div class="tbox">
    <p class="lab">No surprises</p>
    <div class="chip-row">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2540FF" stroke-width="2"><path d="M4 6h16M4 12h10M4 18h7"/></svg>
      Quoted before you pay
    </div>
    <div class="cap">We confirm your exact rate and delivery first</div>
  </div>
  <div class="tbox">
    <p class="lab">Payment</p>
    <div class="chip-row">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2540FF" stroke-width="2"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
      Handled off-site
    </div>
    <div class="cap">Nothing sensitive is stored on this site</div>
  </div>
  <div class="tbox">
    <p class="lab">Your account</p>
    <div class="chip-row">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2540FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v13"/><path d="m7 11 5 5 5-5"/><path d="M4 21h16"/></svg>
      Miles transfer in
    </div>
    <div class="cap">They land in the account you already hold, and you book direct</div>
  </div>
  <div class="tbox">
    <p class="lab">Coverage</p>
    <div class="chip-row">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2540FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18"/></svg>
      {programCount} programmes
    </div>
    <div class="cap">{coverageCap}</div>
  </div>
</div>

{realReviews.length > 0 && (
  <div class="revs">
    {realReviews.map((r) => (
      <a class="rev" href={r.url || undefined} rel="nofollow noopener" target={r.url ? "_blank" : undefined}>
        <span class="rev-stars">{"★".repeat(Math.round(r.rating))}<span class="rev-dim">{"★".repeat(Math.max(0, Math.round(r.outOf) - Math.round(r.rating)))}</span></span>
        <span class="rev-num">{r.rating}<small>/{r.outOf}</small></span>
        <span class="rev-plat">{r.platform}{r.count ? ` · ${r.count.toLocaleString("en-US")} reviews` : ""}</span>
      </a>
    ))}
  </div>
)}

{specs.length > 0 && (
  <div class="spec-strip" style="margin-top:18px">
    {specs.map((s, i) => (
      <>
        {i > 0 && <span class="dot"></span>}
        <span><b>{s.n}</b> {s.l}</span>
      </>
    ))}
  </div>
)}
