---
// Placeholder trust figures — replace with real, verifiable numbers before launch.
---
<div class="trust-grid">
  <div class="tbox">
    <p class="lab">Rating</p>
    <div class="stars">★★★★★</div>
    <div class="cap"><b style="color:var(--text-1);font-family:var(--mono)">4.8/5</b> · 2,000+ Trustpilot reviews</div>
  </div>
  <div class="tbox">
    <p class="lab">Delivered</p>
    <div class="big">10,000+</div>
    <div class="cap">transfers completed</div>
  </div>
  <div class="tbox">
    <p class="lab">Guarantee</p>
    <div class="chip-row">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2540FF" stroke-width="2"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
      Delivery guarantee
    </div>
    <div class="cap">Miles land or you're refunded</div>
  </div>
  <div class="tbox">
    <p class="lab">Security</p>
    <div class="chip-row">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2540FF" stroke-width="2"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
      Bank-grade encryption
    </div>
    <div class="cap">Every order protected</div>
  </div>
</div>
<div class="spec-strip" style="margin-top:18px">
  <span><b>24h</b> delivery</span><span class="dot"></span>
  <span><b>99.9%</b> completion</span><span class="dot"></span>
  <span><b>0</b> account locks</span><span class="dot"></span>
  <span><b>24/7</b> support</span>
</div>
