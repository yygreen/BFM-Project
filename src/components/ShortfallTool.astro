---
// Shortfall calculator: the arithmetic of the actual purchase.
//
// What someone buys is the award amount minus whatever the account already
// holds. That is a small top-up for one visitor and the entire award for the
// next, who is starting from an empty balance — both are ordinary, and the
// tool must not imply either is the normal case.
//
// An empty "already have" field therefore counts as zero rather than as "not
// answered": buying the whole award is the one case where there is genuinely
// nothing to enter, and it should not be the case that requires extra typing.
//
// It also surfaces the thing the buy page's widget only reveals once you type
// an amount: the program's minimum order. Minimums run from 10,000 to 80,000,
// so a visitor short 25,000 United miles cannot buy 25,000 — the smallest
// order is 80,000. Saying that here, in the place where the gap is worked out,
// is more useful than saying it after someone has already picked a number.
//
// The surplus is described as staying in the account rather than as waste,
// because that is what happens: bought miles sit in the visitor's own balance.
import { usd, costOf } from "../lib/money";

interface Props {
  program: string;
  rate: number;          // cents per mile
  verified: boolean;
  min: number;
  max: number;
  award?: number;        // sensible opening figure for "the award needs"
  requestLabel?: string; // what to prefill on /request, e.g. "Emirates Skywards"
  labels?: Record<string, string>;
}
const { program, rate, verified, min, max, award = 0, requestLabel = "", labels = {} } = Astro.props;
const approx = verified ? "" : "~";

const EN = {
  needLabel: "Miles the award needs",
  haveLabel: "Miles you already have (leave blank if none)",
  gap: "You need to buy",
  cost: "Cost to cover it",
  askSmaller: "Ask about {gap} instead",
  enough: "You already have enough. Nothing to buy for this one.",
  ok: "That's {gap} miles to buy, which comes to {cost} at {rate}¢ per mile.",
  underMin: "That's {gap} miles to buy, but {program} orders start at {min}. The smallest order we can place is {min} miles at {cost}; the extra stays in your account for the next booking.",
  overMax: "That's {gap} miles to buy, above the {max} ceiling for a single order. Send it as a request and we'll tell you honestly how to split it.",
  cta: "Price this →",
  numLocale: "en-US",
};
const L = { ...EN, ...labels };
---
<div
  class="sfl"
  data-rate={rate}
  data-approx={approx}
  data-min={min}
  data-max={max}
  data-program={program}
  data-request={requestLabel || program}
>
  <script type="application/json" set:html={JSON.stringify(L)} class="sfl-l10n"></script>
  <div class="sfl-in">
    <div class="stool-fields">
      <div class="field">
        <label for="sf-need">{L.needLabel}</label>
        <input id="sf-need" type="number" inputmode="numeric" step="1000" min="0" value={award || undefined} placeholder="80000" />
      </div>
      <div class="field">
        <label for="sf-have">{L.haveLabel}</label>
        <input id="sf-have" type="number" inputmode="numeric" step="1000" min="0" placeholder="0" />
      </div>
    </div>
  </div>

  {/* Rendered hidden, not as a row of dashes. The savings tool reserves its
      height because it sits in a sticky column that must not grow; this one is
      a plain section, so an empty result block is just dead space above the
      fold until someone types. */}
  <div class="sfl-out" id="sf-out" data-state="empty" hidden>
    <div class="stool-cols">
      <div class="stool-col">
        <span class="k">{L.gap}</span>
        <b id="sf-gap">—</b>
      </div>
      <div class="stool-col vs" aria-hidden="true">=</div>
      <div class="stool-col">
        <span class="k">{L.cost}</span>
        <b id="sf-cost">—</b>
      </div>
    </div>
    <div class="stool-verdict" id="sf-verdict"></div>
    <div class="stool-foot">
      <a class="btn btn-primary stool-cta" id="sf-cta" href="#quote">{L.cta}</a>
      {/* Below the minimum the smallest real order is one answer, but it isn't
          the only one: the amount actually wanted goes to us as a request,
          which neither promises it nor pretends the visitor never asked. */}
      <a class="sfl-ask" id="sf-ask" href="/request" hidden></a>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const root = document.querySelector(".sfl");
    if (!root) return;
    const T = JSON.parse(root.querySelector(".sfl-l10n").textContent);
    const LOC = T.numLocale || "en-US";
    const fmt = (t, m) => t.replace(/\{(\w+)\}/g, (_, k) => m[k] ?? "");
    const rate = parseFloat(root.dataset.rate);
    const approx = root.dataset.approx || "";
    const MIN = parseInt(root.dataset.min, 10);
    const MAX = parseInt(root.dataset.max, 10);
    const program = root.dataset.program;
    const $ = (id) => document.getElementById(id);
    const need = $("sf-need");
    const have = $("sf-have");
    const num = (n) => n.toLocaleString(LOC);
    // mirrors src/lib/money.ts — cents shown, never rounded to the dollar
    const usd = (n) => {
      const c = Math.round(n * 100);
      return "$" + (c / 100).toLocaleString(LOC, {
        minimumFractionDigits: c % 100 === 0 ? 0 : 2, maximumFractionDigits: 2,
      });
    };
    const cost = (m) => usd(Math.round(m * rate) / 100);

    function render() {
      let n = parseInt(need.value, 10);
      // blank means "none", not "unanswered" — buying the whole award is the
              // case with nothing to type, and it shouldn't be the one that stalls
              let h = have.value.trim() === "" ? 0 : parseInt(have.value, 10);
      if (Number.isFinite(n) && n > 5000000) { n = 5000000; need.value = n; }
      if (Number.isFinite(h) && h > 5000000) { h = 5000000; have.value = h; }
      const okN = Number.isFinite(n) && n > 0;
      const okH = Number.isFinite(h) && h >= 0;
      const out = $("sf-out");

      $("sf-ask").hidden = true;
      if (!okN || !okH) {
        out.dataset.state = "empty";
        out.hidden = true;
        return;
      }
      out.hidden = false;

      const gap = Math.max(0, n - h);
      if (gap === 0) {
        out.dataset.state = "enough";
        $("sf-gap").textContent = num(0);
        $("sf-cost").textContent = usd(0);
        $("sf-verdict").textContent = T.enough;
        $("sf-cta").hidden = true;
        return;
      }

      // What you'd actually order: never less than the program's minimum.
      const order = Math.max(gap, MIN);
      $("sf-gap").textContent = num(gap);
      $("sf-cost").textContent = approx + cost(order);
      $("sf-cta").hidden = false;
      $("sf-cta").dataset.order = order;

      const vars = {
        gap: num(gap), min: num(MIN), max: num(MAX), program,
        rate: rate.toLocaleString(LOC), cost: approx + cost(order),
      };
      if (gap > MAX) {
        out.dataset.state = "over";
        $("sf-verdict").textContent = fmt(T.overMax, vars);
        $("sf-cta").hidden = true;
      } else if (gap < MIN) {
        out.dataset.state = "under";
        $("sf-verdict").textContent = fmt(T.underMin, vars);
        const ask = $("sf-ask");
        ask.hidden = false;
        ask.textContent = fmt(T.askSmaller, vars);
        ask.href = "/request?program=" + encodeURIComponent(root.dataset.request) + "&miles=" + gap;
      } else {
        out.dataset.state = "ok";
        $("sf-verdict").textContent = fmt(T.ok, vars);
      }
    }

    need.addEventListener("input", render);
    have.addEventListener("input", render);

    // hands the orderable amount to the quote widget, so the anchor lands on a
    // figure that can actually be bought rather than on the raw shortfall
    $("sf-cta").addEventListener("click", () => {
      const qw = document.getElementById("qw-miles");
      const target = parseInt($("sf-cta").dataset.order || "", 10);
      if (!qw || !Number.isFinite(target)) return;
      qw.value = target;
      qw.dispatchEvent(new Event("input", { bubbles: true }));
    });

    render();
  })();
</script>
