---
// Two-step quote widget: price first, details second, no page scroll between
// them. Replaces the old calculator-then-scroll-to-a-form-at-the-bottom flow,
// where the estimate a visitor had just built sat one long scroll away from
// the thing that captures it.
//
// Step 2 keeps the amount editable and the price live, so changing your mind
// about how many miles you need never means going back a step.
//
// Payment still stays off this site — this is a quote request that emails us.
import { getCollection } from "astro:content";
import { site, quoteFormReady, directBuyRate } from "../lib/site";

const { defaultSlug = null, heading = "What will your miles cost?", sub = "Any programme, any amount — priced instantly." } = Astro.props;

const airlines = (await getCollection("airlines"))
  .map((e) => ({ slug: e.id, ...e.data }))
  .sort((a, b) => a.order - b.order);

const data = airlines.map((a) => ({
  slug: a.slug,
  label: `${a.airline} — ${a.program}`,
  airline: a.airline,
  program: a.program,
  code: a.code,
  color: a.color,
  logo: a.logo ?? null,
  rate: a.pricePerMile,
  verified: a.priceVerified,
  delivery: a.deliveryVerified ? a.delivery.replace("Within ", "") : "",
  min: a.min,
  max: a.max,
  limitsVerified: a.limitsVerified,
  direct: directBuyRate(a.directBuyCents),
}));

const start = defaultSlug
  ? data.find((d) => d.slug === defaultSlug) ?? data[0]
  : data.find((d) => d.verified) ?? data[0];

// A sensible opening amount that is actually orderable for the starting
// programme — every programme carries its own min/max, so a fixed 60,000 would
// sit below the minimum on some of them.
const startAmount = Math.min(Math.max(60000, start.min), start.max);

const accessKey = quoteFormReady ? site.contact.web3formsKeyQuote : "";
const orderEmail = site.contact.orderEmail;
const notWired = orderEmail
  ? `Quote requests aren't connected yet — please email ${orderEmail} and we'll price it for you.`
  : "Quote requests aren't connected yet — please contact us directly and we'll price it for you.";
---
<div class="qw" data-key={accessKey ? "1" : ""}>
  <script type="application/json" set:html={JSON.stringify(data)} class="qw-data"></script>
  <input type="hidden" id="qw-fallback" value={notWired} />

  <div class="qw-head">
    <div>
      <span class="qw-title">{heading}</span>
      <span class="qw-sub">{sub}</span>
    </div>
    <ol class="qw-dots" aria-hidden="true">
      <li class="on" data-dot="1"></li>
      <li data-dot="2"></li>
    </ol>
  </div>

  <!-- STEP 1 — price -->
  <div class="qw-step" data-step="1">
    <div class="qw-controls">
      <div class="field field-wide">
        <label id="qw-program-label" for="qw-program-btn">Programme</label>
        <!-- native select keeps the value and fires change; it is the source of
             truth, the listbox below is only the presentation -->
        <select id="qw-program" class="sr-only" tabindex="-1" aria-hidden="true">
          {data.map((d) => <option value={d.slug} selected={d.slug === start.slug}>{d.label}</option>)}
        </select>
        <div class="csel" id="qw-csel">
          <button type="button" class="csel-btn" id="qw-program-btn"
            aria-haspopup="listbox" aria-expanded="false" aria-labelledby="qw-program-label qw-program-btn">
            <span class={`csel-code${start.logo ? " csel-code-logo" : ""}`} id="qw-csel-code" style={`--c:${start.color}`}>{start.logo ? <img src={start.logo} alt="" /> : start.code}</span>
            <span class="csel-txt">
              <span class="csel-air" id="qw-csel-air">{start.airline}</span>
              <span class="csel-prog" id="qw-csel-prog">{start.program}</span>
            </span>
            <svg class="csel-chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <ul class="csel-list" id="qw-csel-list" role="listbox" aria-labelledby="qw-program-label" hidden>
            {data.map((d) => (
              <li class="csel-opt" role="option" id={`qw-opt-${d.slug}`} data-value={d.slug}
                  aria-selected={d.slug === start.slug ? "true" : "false"}>
                <span class={`csel-code${d.logo ? " csel-code-logo" : ""}`} style={`--c:${d.color}`}>{d.logo ? <img src={d.logo} alt="" /> : d.code}</span>
                <span class="csel-txt">
                  <span class="csel-air">{d.airline}</span>
                  <span class="csel-prog">{d.program}</span>
                </span>
                <span class="csel-price">{d.verified ? "" : "~"}{d.rate}¢</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="field field-wide">
        <label for="qw-miles">How many miles?</label>
        <input id="qw-miles" type="number" inputmode="numeric" step="1000" value={startAmount} min={start.min} max={start.max} />
        <span class="field-help" id="qw-range"></span>
        <button type="button" class="qw-minfix" id="qw-minfix-1" hidden></button>
      </div>
    </div>

    <div class="qw-out">
      <div>
        <span class="qw-k">Estimated cost</span>
        <div class="qw-cost" id="qw-cost">—</div>
        <span class="qw-per" id="qw-per"></span>
      </div>
      <div class="qw-side">
        <div class="qw-row"><span>Rate</span><b id="qw-rate">—</b></div>
        <div class="qw-row" id="qw-delivery-row"><span>Delivery</span><b id="qw-delivery">—</b></div>
        <div class="qw-row qw-save" id="qw-save-row" hidden><span id="qw-save-k">You save</span><b id="qw-save">—</b></div>
      </div>
    </div>

    <p class="qw-note" id="qw-note" hidden>Indicative rate — request a quote and we'll confirm your exact price.</p>
    <button type="button" class="btn btn-primary qw-cta" id="qw-next">Continue →</button>
  </div>

  <!-- STEP 2 — details -->
  <div class="qw-step" data-step="2" hidden>
    <div class="qw-recap">
      <button type="button" class="qw-back" id="qw-back">← Change programme</button>
      <div class="qw-recap-row">
        <span class="qw-recap-prog" id="qw-recap-prog"></span>
        <label class="qw-recap-edit">
          <span class="sr-only">Miles</span>
          <input id="qw-miles-2" type="number" inputmode="numeric" step="1000" />
          <span>miles</span>
        </label>
        <b class="qw-recap-cost" id="qw-recap-cost"></b>
      </div>
      <p class="qw-minline" id="qw-minline" hidden>
        <span id="qw-minmsg"></span>
        <button type="button" class="qw-minfix" id="qw-minfix"></button>
      </p>
    </div>

    <form class="qw-form" id="qw-form">
      <input type="hidden" name="access_key" value={accessKey} />
      <input type="hidden" name="subject" value="New quote / order request — buyflightmiles" />
      <input type="hidden" name="programme" id="qw-f-programme" />
      <input type="hidden" name="miles" id="qw-f-miles" />
      <input type="hidden" name="estimate" id="qw-f-estimate" />
      <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />

      <div class="qw-controls">
        <div class="field">
          <label for="qw-name">Name *</label>
          <input id="qw-name" name="name" type="text" required />
        </div>
        <div class="field">
          <label for="qw-email">Email *</label>
          <input id="qw-email" name="email" type="email" required />
        </div>
        <div class="field field-wide">
          <label for="qw-contact">WhatsApp / Telegram</label>
          <input id="qw-contact" name="contact" type="text" placeholder="Optional — how you'd like us to reply" />
        </div>
      </div>

      <button type="submit" class="btn btn-primary qw-cta" id="qw-submit">Request my quote</button>
      <p class="form-msg" id="qw-msg" hidden></p>
      <p class="qw-foot">Payment stays off-site. We only ask for your loyalty account number once you've approved the quote.</p>
    </form>
  </div>
</div>

<script is:inline>
  (function () {
    const root = document.querySelector(".qw");
    if (!root) return;
    const data = JSON.parse(root.querySelector(".qw-data").textContent);
    const byId = Object.fromEntries(data.map((d) => [d.slug, d]));
    const $ = (id) => document.getElementById(id);
    const usd = (n) => "$" + Math.round(n).toLocaleString("en-US");

    const prog = $("qw-program");
    const miles1 = $("qw-miles");
    const miles2 = $("qw-miles-2");

    function amount() {
      const m = parseInt(miles1.value, 10);
      return Number.isFinite(m) && m > 0 ? m : 0;
    }

    const num = (n) => n.toLocaleString("en-US");

    // Each programme sets its own order size. Carry those onto the input so the
    // field validates against the programme actually selected, not a global
    // floor — otherwise the widget happily prices 10,000 SkyMiles against a
    // 25,000 minimum and quotes an order that would be turned away.
    function applyBounds(c) {
      miles1.min = c.min;
      miles1.max = c.max;
      miles1.placeholder = num(c.min);
      miles2.min = c.min;
      miles2.max = c.max;
    }

    function render() {
      const c = byId[prog.value];
      const m = amount();
      const cost = (m * c.rate) / 100;
      const approx = c.verified ? "" : "~";
      const outOfRange = m > 0 && (m < c.min || m > c.max);
      const ok = m > 0 && !outOfRange;
      // blocked only when the limit is a confirmed rule, not a placeholder
      const blocked = outOfRange && c.limitsVerified;
      const canGo = m > 0 && !blocked;

      // Below the minimum the fix is always the same — order the minimum — so
      // say the number and offer it as one click rather than leaving the buyer
      // to guess. Above the maximum the ceiling is the answer instead.
      const below = m > 0 && m < c.min;
      const target = below ? c.min : c.max;
      // Until the client confirms the order limits, these figures GUIDE but do
      // not assert. Stating "KrisFlyer has a 25,000 mile minimum" as policy —
      // and refusing the order on it — would be publishing an unverified claim
      // about the client's own business, and could turn away business they'd
      // happily take. Once limitsVerified flips, it becomes a firm rule.
      const fixMsg = !outOfRange
        ? ""
        : c.limitsVerified
          ? (below
              ? `${c.program} has a ${num(c.min)} mile minimum.`
              : `${c.program} caps a single order at ${num(c.max)} miles.`)
          : (below
              ? `Orders usually start around ${num(c.min)} miles — ask and we'll quote a smaller one.`
              : `Above about ${num(c.max)} miles we'll quote it as a custom order.`);
      const fixLabel = outOfRange && c.limitsVerified ? `Use ${num(target)}` : "";

      const range = $("qw-range");
      range.textContent = outOfRange ? fixMsg
        : c.limitsVerified ? `${num(c.min)} minimum, ${num(c.max)} maximum.`
        : `Most orders run ${num(c.min)}–${num(c.max)} miles.`;
      range.classList.toggle("warn", outOfRange);

      const fix1 = $("qw-minfix-1");
      fix1.hidden = !(outOfRange && c.limitsVerified);
      fix1.textContent = fixLabel;
      fix1.dataset.target = target;

      // Step 2 showed a bare "—" for the price with nothing to explain it, and
      // its submit button stayed live, so an unbuyable amount could be sent.
      const minline = $("qw-minline");
      minline.hidden = !outOfRange;
      $("qw-minmsg").textContent = fixMsg;
      const fix2 = $("qw-minfix");
      fix2.textContent = fixLabel;
      fix2.dataset.target = target;

      // Never price an amount the programme won't accept, and don't let it
      // reach step 2 or the inbox — a quote we'd have to retract is worse than
      // no quote.
      $("qw-next").disabled = !canGo;
      $("qw-submit").disabled = !canGo;

      $("qw-cost").textContent = blocked ? "—" : m ? approx + usd(cost) : "$0";
      // "≈" already signals approximation — don't also prefix "~"
      $("qw-per").textContent = "≈ $" + Math.round(c.rate * 10) + " per 1,000 miles";
      $("qw-rate").textContent = approx + c.rate + "¢/mi";
      $("qw-delivery").textContent = c.delivery || "On quote";
      $("qw-note").hidden = c.verified;

      // savings only against a sourced airline rate
      const saveRow = $("qw-save-row");
      if (c.direct && c.direct > c.rate && canGo) {
        $("qw-save-k").textContent = "You save vs " + c.direct + "¢ direct";
        $("qw-save").textContent = usd(Math.max(0, (m * c.direct) / 100 - cost));
        saveRow.hidden = false;
      } else {
        saveRow.hidden = true;
      }

      // step 2 recap + hidden fields that actually get emailed
      $("qw-recap-prog").textContent = c.label;
      $("qw-recap-cost").textContent = canGo ? approx + usd(cost) : "—";
      if (document.activeElement !== miles2) miles2.value = m || "";
      $("qw-f-programme").value = c.label;
      $("qw-f-miles").value = canGo ? m : "";
      $("qw-f-estimate").value = canGo ? approx + usd(cost) + " at " + c.rate + "c/mile" : "";
    }

    // ---- custom programme dropdown ------------------------------------
    // The native <select> above still holds the value and fires change; this
    // only replaces its unstylable option list.
    (function () {
      const wrap = document.getElementById("qw-csel");
      const btn = document.getElementById("qw-program-btn");
      const list = document.getElementById("qw-csel-list");
      if (!wrap || !btn || !list) return;
      const opts = Array.from(list.querySelectorAll(".csel-opt"));
      let active = Math.max(0, opts.findIndex((o) => o.dataset.value === prog.value));

      function paint() {
        const c = byId[prog.value];
        document.getElementById("qw-csel-air").textContent = c.airline;
        document.getElementById("qw-csel-prog").textContent = c.program;
        const code = document.getElementById("qw-csel-code");
        code.innerHTML = "";
        code.classList.toggle("csel-code-logo", !!c.logo);
        if (c.logo) {
          const img = document.createElement("img");
          img.src = c.logo; img.alt = "";
          code.appendChild(img);
        } else {
          code.textContent = c.code;
        }
        code.style.setProperty("--c", c.color);
        opts.forEach((o) => o.setAttribute("aria-selected", String(o.dataset.value === prog.value)));
      }
      function highlight(i) {
        active = (i + opts.length) % opts.length;
        opts.forEach((o, n) => o.classList.toggle("on", n === active));
        btn.setAttribute("aria-activedescendant", opts[active].id);
        opts[active].scrollIntoView({ block: "nearest" });
      }
      function open() {
        list.hidden = false;
        btn.setAttribute("aria-expanded", "true");
        highlight(Math.max(0, opts.findIndex((o) => o.dataset.value === prog.value)));
      }
      function close() {
        list.hidden = true;
        btn.setAttribute("aria-expanded", "false");
        btn.removeAttribute("aria-activedescendant");
      }
      const isOpen = () => !list.hidden;

      function choose(i) {
        prog.value = opts[i].dataset.value;
        prog.dispatchEvent(new Event("change", { bubbles: true }));
        paint();
        close();
        btn.focus({ preventScroll: true });
      }

      btn.addEventListener("click", () => (isOpen() ? close() : open()));
      opts.forEach((o, i) => {
        o.addEventListener("click", () => choose(i));
        o.addEventListener("mousemove", () => highlight(i));
      });
      btn.addEventListener("keydown", (e) => {
        if (e.key === "ArrowDown" || e.key === "ArrowUp") {
          e.preventDefault();
          if (!isOpen()) return open();
          highlight(active + (e.key === "ArrowDown" ? 1 : -1));
        } else if (e.key === "Home" && isOpen()) { e.preventDefault(); highlight(0); }
        else if (e.key === "End" && isOpen()) { e.preventDefault(); highlight(opts.length - 1); }
        else if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          isOpen() ? choose(active) : open();
        } else if (e.key === "Escape" && isOpen()) { e.preventDefault(); close(); }
        else if (e.key === "Tab" && isOpen()) close();
        else if (/^[a-z0-9]$/i.test(e.key)) {
          // type-ahead on the airline name, like a native select
          const from = isOpen() ? active + 1 : 0;
          const order = opts.map((_, n) => (from + n) % opts.length);
          const hit = order.find((n) => opts[n].textContent.trim().toLowerCase().startsWith(e.key.toLowerCase()));
          if (hit !== undefined) { if (!isOpen()) open(); highlight(hit); }
        }
      });
      document.addEventListener("click", (e) => { if (isOpen() && !wrap.contains(e.target)) close(); });

      paint();
      prog.addEventListener("change", paint);
    })();

    // Switching programme clears the amount and asks for it again. Carrying the
    // previous number over re-prices silently against a different rate and a
    // different min/max, so the visitor can end up looking at a figure they
    // never asked for — and one the new programme may not even accept.
    prog.addEventListener("change", () => {
      const c = byId[prog.value];
      applyBounds(c);
      miles1.value = "";
      miles2.value = "";
      render();
      miles1.focus();
    });
    // one click puts the order on the nearest bound it can actually be placed at
    function useTarget(e) {
      const v = e.currentTarget.dataset.target;
      miles1.value = v;
      miles2.value = v;
      render();
    }
    $("qw-minfix-1").addEventListener("click", useTarget);
    $("qw-minfix").addEventListener("click", useTarget);

    miles1.addEventListener("input", render);
    // editing the amount on step 2 drives step 1's field, so there is one source of truth
    miles2.addEventListener("input", () => { miles1.value = miles2.value; render(); });

    function show(step) {
      root.querySelectorAll(".qw-step").forEach((el) => {
        el.hidden = el.dataset.step !== String(step);
      });
      root.querySelectorAll(".qw-dots li").forEach((el) => {
        el.classList.toggle("on", Number(el.dataset.dot) <= step);
      });
    }

    $("qw-next").addEventListener("click", () => {
      if (!amount()) { miles1.focus(); return; }
      show(2);
      $("qw-name").focus({ preventScroll: true });
    });
    $("qw-back").addEventListener("click", () => {
      show(1);
      prog.focus({ preventScroll: true });
    });

    // submit
    const form = $("qw-form");
    const msg = $("qw-msg");
    const btn = $("qw-submit");
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!root.dataset.key) {
        msg.textContent = $("qw-fallback").value;
        msg.className = "form-msg err"; msg.hidden = false; return;
      }
      const label = btn.textContent;
      btn.disabled = true; btn.textContent = "Sending…"; msg.hidden = true;
      try {
        const res = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const json = await res.json();
        if (json.success) {
          form.reset();
          msg.textContent = "Thanks — your request is in. We'll confirm your exact rate and delivery shortly.";
          msg.className = "form-msg ok";
        } else {
          msg.textContent = json.message || "Something went wrong. Please email us instead.";
          msg.className = "form-msg err";
        }
      } catch (err) {
        msg.textContent = "Network error. Please try again, or email us directly.";
        msg.className = "form-msg err";
      } finally {
        msg.hidden = false; btn.disabled = false; btn.textContent = label;
      }
    });

    applyBounds(byId[prog.value]);
    render();
  })();
</script>
