---
import Emblem from "./Emblem.astro";
import { site } from "../lib/site";
const { a, cta = "Buy miles" } = Astro.props;
const per1000 = Math.round(a.pricePerMile * 10);
const fmt = (n) => n.toLocaleString("en-US");
const verified = a.priceVerified;
const ctaText = verified ? cta : "Request a live quote";
---
<div class="pcard">
  <div class="top">
    <div style="display:flex;align-items:center;gap:14px">
      <Emblem code={a.code} color={a.color} logo={a.logo} logoAlt={a.logoAlt} size={48} />
      <div>
        <p class="plabel">{a.airline}</p>
        <p class="pname">{a.program}</p>
      </div>
    </div>
    {a.inStock
      ? <span class="badge badge-ok">In stock</span>
      : <span class="badge badge-warn">Limited</span>}
  </div>
  <div class="price">
    <span class="num">{verified ? "" : "~"}{a.pricePerMile}¢</span><span class="unit">/ mile</span>
    {!verified && <span class="indic">indicative</span>}
  </div>
  <p class="alt">≈ ${per1000} per 1,000 miles{verified ? "" : " · confirmed on quote"}</p>
  <div class="rows">
    <div class="r"><span>Delivery</span><b>{a.deliveryVerified ? a.delivery.replace("Within ", "") : "on quote"}</b></div>
    <div class="r"><span>Minimum</span><b>{fmt(a.min)}</b></div>
    <div class="r"><span>Maximum</span><b>{fmt(a.max)}</b></div>
  </div>
  <a class="btn btn-primary" href="#quote">{ctaText}</a>
  <p class="foot">Secure transfer · {site.guarantee.verified ? site.guarantee.shortLabel : "rate confirmed before you pay"}</p>
</div>
