---
const { a, cta = "Buy miles" } = Astro.props;
const per1000 = Math.round(a.pricePerMile * 10);
const fmt = (n) => n.toLocaleString("en-US");
---
<div class="pcard">
  <div class="top">
    <div>
      <p class="plabel">{a.airline}</p>
      <p class="pname">{a.program}</p>
    </div>
    {a.inStock
      ? <span class="badge badge-ok">In stock</span>
      : <span class="badge badge-warn">Limited</span>}
  </div>
  <div class="price"><span class="num">{a.pricePerMile}¢</span><span class="unit">/ mile</span></div>
  <p class="alt">≈ ${per1000} per 1,000 miles</p>
  <div class="rows">
    <div class="r"><span>Delivery</span><b>{a.delivery.replace("Within ", "")}</b></div>
    <div class="r"><span>Minimum</span><b>{fmt(a.min)}</b></div>
    <div class="r"><span>Maximum</span><b>{fmt(a.max)}</b></div>
  </div>
  <a class="btn btn-primary" href="/#programs">{cta}</a>
  <p class="foot">Secure transfer · delivery guaranteed</p>
</div>
