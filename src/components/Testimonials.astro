---
// Testimonials come from src/data/site.json and render only when the client
// has confirmed each one is a real quote from a real customer (verified: true).
// Paste real Trustpilot/customer quotes into that file — never write them here.
import { realTestimonials } from "../lib/site";

// avatar initial + a rotating tone class for visual variety
const tones = ["", "g", "d"];
const items = realTestimonials.map((t, i) => ({
  ...t,
  av: t.name.trim().charAt(0).toUpperCase(),
  tone: tones[i % tones.length],
}));
---
<div class="testi-grid">
  {items.map((t) => (
    <figure class="testi">
      <div class="stars">★★★★★</div>
      <blockquote class="quote">“{t.quote}”</blockquote>
      <figcaption class="who">
        <div class={`avatar ${t.tone}`}>{t.av}</div>
        <div>
          <div class="name">{t.name}</div>
          <div class="role">{t.role}</div>
        </div>
      </figcaption>
    </figure>
  ))}
</div>
