---
// The sticky contact dock, bottom right of every page.
//
// Why it exists: this is a four-figure purchase from a vendor the buyer has
// never used, in a category they have been warned is full of scams. The single
// question that decides the sale is "is there a person behind this site", and
// the answer was previously a phone number in the footer. Every competitor
// selling at this price point (business-class.com runs four numbers on one
// page) keeps a reachable human pinned to the viewport instead.
//
// Collapsed it has two faces, decided in CSS by whether the page's free
// margin can hold them without covering content: the full pill — number
// visible, tappable straight into a call, caret opening the rest — on wide
// screens where it fits beside the content column, and a compact round
// phone button everywhere else, which opens the panel where the call row is
// the first thing under the two options. Never covering the page's own
// words outranks showing the number.
//
// Everything it publishes comes from site.json's verified contact block, so
// an unconfirmed channel is absent rather than wrong, and the whole dock
// disappears if contact.verified is ever turned off. The support-hours line
// above the number is the same deal: it renders the client's real hours or
// nothing at all. No "24/7" until someone confirms it is true.
//
// <details> carries the open/closed state, so the panel works with no JS at
// all. The script only adds what markup cannot: outside-click, Escape, and
// the close button (hidden until JS is present, so it is never a dead control).
import { site, officialChannels, live } from "../lib/site";
import { LOCALES } from "../lib/locales";

const { lang = "en" } = Astro.props;

// English is the fallback for every string, so a locale that adds no `dock`
// block still gets a working dock rather than blank rows.
const EN: Record<string, string> = {
  lab: "Talk to us",
  title: "Talk to a real person",
  sub: "Ask about rates, delivery or payment before you buy.",
  optQuote: "I want to buy miles",
  optOrder: "Question about an order",
  ordiv: "or",
  call: "Call us",
  callSub: "Talk it through before you pay",
  chat: "Chat on WhatsApp",
  chatSub: "Send us a message",
  close: "Close",
  more: "More ways to reach us",
  waPrefill: "Hi, I have a question about buying miles.",
};

const chrome = LOCALES[lang.toLowerCase()];
const t = { ...EN, ...(chrome?.dock ?? {}) };
// <html> carries no dir on the Arabic pages (only the article body does), so
// the dock declares its own: labels, icon order and chevrons all flow the
// right way. Its corner does not move — it is pinned right physically, so the
// widget sits where it does on every other page.
const dir = chrome?.dir ?? "ltr";

const ways = officialChannels();
const phone = ways.find((c) => c.kind === "phone");
const chat = ways.find((c) => c.kind === "whatsapp");
const wa = chat ? `${chat.href}?text=${encodeURIComponent(t.waPrefill)}` : null;

// The client's stated support hours, once confirmed. Until then the pill
// carries a plain invitation rather than a coverage claim we cannot stand up.
const hours = live(site.trust.supportHours) ? String(site.trust.supportHours.value) : null;
const label = hours ?? t.lab;

// Localized pages live under /{locale}/buy/*; the two panel destinations are
// English-only pages, so they are linked as they are rather than to a route
// that does not exist.
const show = Boolean(phone || chat);
---

{show && (
  <div class="dock" id="dock" dir={dir}>
    <div class="dock-bar">
      {phone ? (
        <a class="dock-tel" href={phone.href}>
          <span class="dock-lab">{label}</span>
          <b>{phone.value}</b>
        </a>
      ) : (
        <a class="dock-tel" href={wa} target="_blank" rel="noopener">
          <span class="dock-lab">{label}</span>
          <b>{chat.value}</b>
        </a>
      )}
      <details class="dock-d" id="dock-d">
        <summary class="dock-more" aria-label={t.more}>
          {/* two faces for one control: the caret beside the number on wide
              screens, the phone glyph when the dock is the compact circle */}
          <svg class="dock-caret" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          <svg class="dock-fab-ic" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </summary>

        <div class="dock-panel">
          <button class="dock-x" type="button" aria-label={t.close}>
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>

          <p class="dock-h">{t.title}</p>
          <p class="dock-s">{t.sub}</p>

          <a class="dock-opt" href="/request">
            <span>{t.optQuote}</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </a>
          <a class="dock-opt" href="/contact">
            <span>{t.optOrder}</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </a>

          <p class="dock-or"><span>{t.ordiv}</span></p>

          {phone && (
            <a class="dock-ch" href={phone.href}>
              <span class="dock-ic">
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </span>
              <span class="dock-ct">
                <b>{phone.value}</b>
                <span>{t.callSub}</span>
              </span>
            </a>
          )}

          {chat && (
            <a class="dock-ch wa" href={wa} target="_blank" rel="noopener">
              <span class="dock-ic">
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 21l2.2-5.2A8.5 8.5 0 1 1 21 11.5z"/></svg>
              </span>
              <span class="dock-ct">
                <b>{t.chat}</b>
                <span>{t.chatSub}</span>
              </span>
            </a>
          )}
        </div>
      </details>
    </div>
  </div>
)}

{show && (
  <script is:inline>
    (function () {
      var dock = document.getElementById("dock");
      var d = document.getElementById("dock-d");
      if (!dock || !d) return;
      // Marks the dock as scripted: the close button is styled out until this
      // runs, so a no-JS visitor never meets a button that does nothing.
      dock.classList.add("js");
      var x = dock.querySelector(".dock-x");
      if (x) x.addEventListener("click", function () { d.open = false; });
      document.addEventListener("click", function (e) {
        if (d.open && !d.contains(e.target)) d.open = false;
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && d.open) {
          d.open = false;
          d.querySelector("summary").focus();
        }
      });
    })();
  </script>
)}
