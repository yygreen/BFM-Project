---
// FAQ. Questions are worded to match how people actually search — Semrush
// shows the demand is overwhelmingly in question form and per-airline
// ("how much does it cost to buy American Airlines miles" ~260/mo, "how to
// buy american airlines miles" ~480/mo), so programme pages ask the question
// with the airline's name in it rather than a generic phrasing.
//
// Answers that depend on client-confirmed facts (payments, the guarantee,
// delivery mechanics) come from src/data/site.json and fall back to an honest
// holding answer — never to an invented claim. See LAUNCH.md.
//
// Emits FAQPage JSON-LD so the answers are eligible for rich results.
import { site, live, paymentSentence } from "../lib/site";

const {
  delivery = "24 hours",
  airline = null,        // e.g. "American Airlines" — switches to per-airline wording
  program = null,        // e.g. "AAdvantage"
  pricePerMile = null,
  priceVerified = false,
  extras = [],          // per-programme Q&As from airlines.json (faqExtras)
} = Astro.props;

const window = delivery.replace("Within ", "");
const subject = airline ? `${airline} miles` : "airline miles";
const approx = priceVerified ? "" : "about ";

// ---- cost -------------------------------------------------------------
const costAnswer = pricePerMile
  ? `Buying ${subject} here costs ${approx}${pricePerMile}¢ per mile — ${approx}$${Math.round(pricePerMile * 10)} per 1,000 miles. ${priceVerified ? "That rate is confirmed" : "That rate is indicative and we confirm the exact figure"} on your quote, before any payment is made. Use the calculator on this page to price the amount you actually need; the quote itself is free and no-obligation.`
  : "It depends on the programme — each has its own per-mile rate, shown on its page. Price the amount you need with the calculator and we'll confirm the exact figure on your quote, before any payment is made. The quote is free and no-obligation.";

// ---- can you ----------------------------------------------------------
const canAnswer = `Yes. ${airline ? `${airline} miles are` : "Miles are"} transferred into the loyalty account you already hold, and you book directly with the airline afterwards. You don't open anything new, and you keep control of the reservation. We are not affiliated with any airline or loyalty programme.`;

// ---- delivery ---------------------------------------------------------
const deliveryAnswer = site.delivery.verified && site.delivery.howItWorks
  ? site.delivery.howItWorks
  : `Most transfers land in your account within ${window}. The exact window is shown on each programme's page, and you'll get confirmation the moment the transfer completes.`;

// ---- worth it ---------------------------------------------------------
const worthAnswer = `It depends on what you're booking. Buying miles makes sense when you're short of a specific redemption and the miles cost less than the cash fare — a premium-cabin seat is the usual case. It rarely makes sense to buy speculatively, without a booking in mind. Confirm the award seat is available first, then buy the shortfall.`;

// ---- payments ---------------------------------------------------------
const pay = paymentSentence();
const paymentAnswer = pay
  ? [
      `We accept ${pay}.`,
      site.payments.usdtNetworks.length ? `USDT is accepted on ${site.payments.usdtNetworks.join(" and ")}.` : "",
      site.payments.minOrderUsd ? `Minimum order is $${site.payments.minOrderUsd.toLocaleString("en-US")}.` : "",
      site.payments.cardAnswer,
    ].filter(Boolean).join(" ")
  : "We'll confirm the accepted payment methods when we send your quote. Payment is always handled off this site.";

// ---- legitimacy -------------------------------------------------------
const proof = [
  live(site.trust.transfersCompleted)
    ? `We've completed ${Number(site.trust.transfersCompleted.value).toLocaleString("en-US")}+ transfers`
    : "",
  site.trust.rating.verified && site.trust.rating.value
    ? `and hold a ${site.trust.rating.value}/${site.trust.rating.outOf} rating${site.trust.rating.source ? ` on ${site.trust.rating.source}` : ""}`
    : "",
].filter(Boolean).join(" ");

const legitAnswer = [
  "Yes.",
  proof ? proof + "." : "",
  site.guarantee.verified ? `Every order is backed by our ${site.guarantee.shortLabel} — ${site.guarantee.summary}` : "",
  "You get a firm quote confirming your exact rate and delivery window before any payment is made, and the miles go into an account you already control.",
].filter(Boolean).join(" ");

// ---- assembled --------------------------------------------------------
const faqs = [
  { q: airline ? `How much does it cost to buy ${airline} miles?` : "How much does it cost to buy airline miles?", a: costAnswer, open: true },
  { q: airline ? `Can you buy ${airline} miles?` : "Can you buy airline miles?", a: canAnswer },
  { q: airline ? `How fast are ${program || airline} miles delivered?` : "How fast are miles delivered?", a: deliveryAnswer },
  // programme-specific questions slot in here, near the top, and join the
  // FAQPage JSON-LD with everything else
  ...extras.map((e) => ({ q: e.q, a: e.a })),
  { q: "Is buying airline miles worth it?", a: worthAnswer },
  { q: "What payment methods do you accept?", a: paymentAnswer },
  ...(site.guarantee.verified && site.guarantee.policy
    ? [{ q: "What if my miles don't arrive?", a: site.guarantee.policy }]
    : []),
  { q: "Is this legitimate?", a: legitAnswer },
  { q: "Will buying miles affect my account?", a: "We handle every transfer carefully to protect your account. If you have questions about a specific programme, reach out before ordering and we'll walk you through it." },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---
{faqs.map((f) => (
  <details class="faq" open={f.open}>
    <summary>{f.q}<span class="mk">+</span></summary>
    <div class="ans">{f.a}</div>
  </details>
))}
<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
