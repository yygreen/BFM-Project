---
// FAQ. Questions are worded to match how people actually search — Semrush
// shows the demand is overwhelmingly in question form and per-airline
// ("how much does it cost to buy American Airlines miles" ~260/mo, "how to
// buy american airlines miles" ~480/mo), so program pages ask the question
// with the airline's name in it rather than a generic phrasing.
//
// Answers that depend on client-confirmed facts (payments, the guarantee,
// delivery mechanics) come from src/data/site.json and fall back to an honest
// holding answer — never to an invented claim. See LAUNCH.md.
//
// Layout: one flat list on one surface, full width. Deliberately NOT the
// stacked-white-cards accordion: that silhouette is the stock FAQ widget on
// every site in this market, and a page selling trust should not open its
// questions section looking like a template.
//
// Rows carry their key figure as a monospace chip while closed (rate,
// delivery window, payment methods), so the closed state is informative
// instead of uniform. Chips exist only where the answer's number is real:
// an unverified rate keeps its tilde, an unconfirmed payment list shows no
// chip at all.
//
// Emits FAQPage JSON-LD so the answers are eligible for rich results.
import { site, live, paymentSentence } from "../lib/site";
import { usd, per1000 } from "../lib/money";

const {
  delivery = "24 hours",
  airline = null,        // e.g. "American Airlines" — switches to per-airline wording
  program = null,        // e.g. "AAdvantage"
  pricePerMile = null,
  priceVerified = false,
  extras = [],          // per-program Q&As from airlines.json (faqExtras)
  // The homepage shows a shortened set and links to /faq for the rest; the
  // full set — and the FAQPage markup for it — lives on that page alone, so
  // the same questions aren't published twice under two URLs.
  limit = null,
  // Questions to leave out, by key. A program page omits "worth" because the
  // cash-vs-miles verdict is that program's calculator page's job, and asking
  // it in both places puts two near-identical Q&As into two FAQPage blocks on
  // one site, where they compete rather than compound.
  omit = [],
  jsonld = true,
} = Astro.props;

const window = delivery.replace("Within ", "");
const subject = airline ? `${airline} miles` : "airline miles";
const approx = priceVerified ? "" : "about ";

// ---- cost -------------------------------------------------------------
const costAnswer = pricePerMile
  ? `Buying ${subject} here costs ${approx}${pricePerMile}¢ per mile — ${approx}${usd(per1000(pricePerMile))} per 1,000 miles. ${priceVerified ? "That rate is confirmed" : "That rate is indicative and we confirm the exact figure"} on your quote, before any payment is made. Use the calculator on this page to price the amount you actually need; the quote itself is free and no-obligation.`
  : "It depends on the program — each has its own per-mile rate, shown on its page. Price the amount you need with the calculator and we'll confirm the exact figure on your quote, before any payment is made. The quote is free and no-obligation.";

// ---- can you ----------------------------------------------------------
const canAnswer = `Yes. ${airline ? `${airline} miles are` : "Miles are"} transferred into the loyalty account you already hold, and you book directly with the airline afterwards. You don't open anything new, and you keep control of the reservation. We are not affiliated with any airline or loyalty program.`;

// ---- delivery ---------------------------------------------------------
const deliveryAnswer = site.delivery.verified && site.delivery.howItWorks
  ? site.delivery.howItWorks
  : `Most transfers land in your account within ${window}. The exact window is shown on each program's page, and you'll get confirmation the moment the transfer completes.`;

// ---- worth it ---------------------------------------------------------
const worthAnswer = `It depends on what you're booking. Buying miles makes sense when you're short of a specific redemption and the miles cost less than the cash fare — a premium-cabin seat is the usual case. It rarely makes sense to buy speculatively, without a booking in mind. Confirm the award seat is available first, then buy the shortfall.`;

// ---- payments ---------------------------------------------------------
const pay = paymentSentence();
const paymentAnswer = pay
  ? [
      `We accept ${pay}.`,
      site.payments.usdtNetworks.length ? `USDT is accepted on ${site.payments.usdtNetworks.join(" and ")}.` : "",
      site.payments.minOrderUsd ? `Minimum order is $${site.payments.minOrderUsd.toLocaleString("en-US")}.` : "",
      site.payments.cardAnswer,
    ].filter(Boolean).join(" ")
  : "We'll confirm the accepted payment methods when we send your quote. Payment is always handled off this site.";

// ---- legitimacy -------------------------------------------------------
const proof = [
  live(site.trust.transfersCompleted)
    ? `We've completed ${Number(site.trust.transfersCompleted.value).toLocaleString("en-US")}+ transfers`
    : "",
  site.trust.rating.verified && site.trust.rating.value
    ? `and hold a ${site.trust.rating.value}/${site.trust.rating.outOf} rating${site.trust.rating.source ? ` on ${site.trust.rating.source}` : ""}`
    : "",
].filter(Boolean).join(" ");

const legitAnswer = [
  "Yes.",
  proof ? proof + "." : "",
  site.guarantee.verified ? site.guarantee.summary : "",
  "You get a firm quote confirming your exact rate and delivery window before any payment is made, and the miles go into an account you already control.",
].filter(Boolean).join(" ");

// ---- row chips --------------------------------------------------------
// The figure each answer hangs on, surfaced on the closed row in mono. "24
// hours" compacts to "24h" so the chip stays a glance, and the tilde carries
// through so an indicative rate never sheds its qualifier on the way up.
const rateChip = pricePerMile ? `${priceVerified ? "" : "~"}${pricePerMile}¢/mi` : null;
const windowChip = window.replace(/\s*hours?\b/, "h");
const payChip = pay ? site.payments.methods.join(" · ") : null;

// ---- assembled --------------------------------------------------------
const faqs = [
  { q: airline ? `How much does it cost to buy ${airline} miles?` : "How much does it cost to buy airline miles?", a: costAnswer, chip: rateChip, open: true },
  { q: airline ? `Can you buy ${airline} miles?` : "Can you buy airline miles?", a: canAnswer },
  { q: airline ? `How fast are ${program || airline} miles delivered?` : "How fast are miles delivered?", a: deliveryAnswer, chip: windowChip },
  // program-specific questions slot in here, near the top, and join the
  // FAQPage JSON-LD with everything else
  ...extras.map((e) => ({ q: e.q, a: e.a })),
  ...(omit.includes("worth") ? [] : [{ q: "Is buying airline miles worth it?", a: worthAnswer }]),
  { q: "What payment methods do you accept?", a: paymentAnswer, chip: payChip },
  ...(site.guarantee.verified && site.guarantee.policy
    ? [{ q: "What if my miles don't arrive?", a: site.guarantee.policy }]
    : []),
  { q: "Is this legitimate?", a: legitAnswer },
  { q: "Will buying miles affect my account?", a: "We handle every transfer carefully to protect your account. If you have questions about a specific program, reach out before ordering and we'll walk you through it." },
  // Account-control check. Suppressed until the client confirms the process is
  // real — it is the answer to "what stops someone having miles sent into an
  // account that isn't theirs", which is worth nothing if we don't do it.
  ...(site.verification.verified
    ? [{ q: "How do you know the account is really mine?", a: `${site.verification.summary} ${site.verification.why}` }]
    : []),
];

const shown = limit ? faqs.slice(0, limit) : faqs;

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: shown.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

---
<div class="faqx-list">
  {shown.map((f) => (
    <details class="faq" open={f.open}>
      <summary>
        <span class="faq-q">{f.q}</span>
        {f.chip && <span class="faq-chip">{f.chip}</span>}
        <span class="faq-mk" aria-hidden="true"></span>
      </summary>
      <div class="ans">{f.a}</div>
    </details>
  ))}
</div>
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
