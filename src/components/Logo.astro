---
// Brand lockup: circular emblem + wordmark.
//
// The emblem is inline SVG so it stays crisp at any size and needs no extra
// request; the wordmark stays real text so it uses the site font, is
// selectable, and reads correctly to screen readers.
//
// If the original vector asset turns up, drop it at /public/logo.svg and
// swap the <svg> below for an <img> — nothing else needs to change.
const { variant = "dark", size = 30 } = Astro.props;

// dark  = navy mark for light backgrounds (header)
// light = white mark for the dark footer
const ink = variant === "light" ? "#FFFFFF" : "#1B2A6B";
const mark = "#E8482A";
---
<span class={`logo logo-${variant}`}>
  <svg
    class="logo-mark"
    width={size}
    height={size}
    viewBox="0 0 64 64"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="32" cy="32" r="28" stroke={ink} stroke-width="4" />
    <!-- swoosh: a route sweeping up to the right, tail trailing behind -->
    <path
      d="M14 40 C24 40 30 36 40 26"
      stroke={mark}
      stroke-width="3"
      stroke-linecap="round"
      fill="none"
    />
    <path d="M36 30 L46 22 L42 34 Z" fill={mark} />
  </svg>
  <span class="logo-word">buyflightmiles</span>
</span>
