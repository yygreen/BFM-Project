---
// Brand lockup — "the last miles, closed". A route line trails off into three
// coral dots short of its destination waypoint; the gap is the product. Both
// variants are SVGs with the wordmark converted to outlines, so the logo has
// no font dependency and stays crisp at every size (the old asset was a 1×
// PNG traced off the WordPress theme).
//
// The files are generated, not hand-drawn — see scripts/brand/. The solid
// route, the dots and the ring derive from ONE bézier, with the dots placed
// at true arc-length positions. To tweak the mark, regenerate — don't nudge
// coordinates in the SVGs.
//
// dark  = ink wordmark for light backgrounds (header)
// light = white wordmark + lifted cobalt for the dark footer
const { variant = "dark", size = 30 } = Astro.props;
const src = variant === "light" ? "/logo-light.svg" : "/logo.svg";
// both files share one viewBox: 239×44
const ratio = 239 / 44;
---
<span class={`logo logo-${variant}`}>
  <img src={src} alt="buyflightmiles" width={Math.round(size * ratio)} height={size} />
</span>
