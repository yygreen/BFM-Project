---
// Brand lockup — the actual buyflightmiles asset, taken from the live site
// (its theme ships 1x PNGs only; if a vector or 2x export turns up, drop it
// in /public and point these paths at it — nothing else changes).
//
// dark  = navy mark for light backgrounds (header)
// light = white mark for the dark footer
const { variant = "dark", size = 30 } = Astro.props;
const src = variant === "light" ? "/footer-logo.png" : "/logo.png";
// natural sizes: logo.png 172×40, footer-logo.png 165×54 — width/height
// attributes keep the layout from shifting while the image loads
const ratio = variant === "light" ? 165 / 54 : 172 / 40;
---
<span class={`logo logo-${variant}`}>
  <img src={src} alt="buyflightmiles" width={Math.round(size * ratio)} height={size} />
</span>
