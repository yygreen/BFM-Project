---
// Custom illustration set for "Three steps to the seat".
//
// Replaces three generic stroke icons sitting in three differently-tinted
// rounded squares — an icon in a box is the most generic thing a site can do,
// and the three pastel fills pulled a third colour into a two-colour brand.
//
// The motif is ONE wave. Read left to right across the three columns it rises,
// eases over, and climbs out into the plane — a single continuous motion, not
// three separate diagrams that happen to share a colour. Three rules hold that
// together:
//
//   1. Every panel crosses its boundary on a HORIZONTAL tangent, at a height
//      its neighbour repeats (72 → 40 → 58). Matching both the value and the
//      slope is what makes the seam invisible; matching only the value leaves
//      a visible corner.
//   2. Each path overshoots its own viewBox (x from -10 to 250) so the stroke
//      bridges the 24px grid gutter instead of stopping at the column edge.
//      `overflow:visible` on .illo is what lets it. The overshoot is flat, so
//      the two sides meet at the same height however wide the column gets.
//   3. Each panel carries exactly ONE coral waypoint, at x=26 — the same
//      position in every panel, sitting on the flat lead-in so it is genuinely
//      ON the line rather than eyeballed next to it. Coral means "you are
//      here" and nothing else; every supporting form is cobalt or mist, and
//      each sits in the left third so it reads against its own step label
//      rather than drifting over the next column's.
//
// The plane is anchored the same way: its trailing notch is the path's final
// point, so it terminates the line instead of floating past the end of it.
interface Props { step: "choose" | "pay" | "fly" }
const { step } = Astro.props;
---
{step === "choose" && (
  <svg class="illo" viewBox="0 0 240 120" role="img" aria-label="Choosing a programme and an amount of miles">
    <path class="il-line" d="M0 72H26C90 72 170 40 236 40H250" />

    <!-- programme options, the chosen one filled — tethered to the waypoint on
         the same rule as step 2's shield -->
    <path class="il-link" d="M32 54L38 35" />
    <rect class="il-opt" x="40" y="8" width="66" height="9" rx="4.5" />
    <rect class="il-opt-on" x="40" y="24" width="86" height="11" rx="5.5" />
    <rect class="il-opt" x="40" y="42" width="54" height="9" rx="4.5" />

    <circle class="il-ring" cx="26" cy="72" r="15" />
    <circle class="il-dot" cx="26" cy="72" r="6.5" />
  </svg>
)}

{step === "pay" && (
  <svg class="illo" viewBox="0 0 240 120" role="img" aria-label="The quote confirmed, then paid away from this site">
    <path class="il-line" d="M-10 40H26C100 40 170 58 236 58H250" />

    <!-- the quote, held — tethered back to THIS step's waypoint rather than
         trailing off to a loose node the reader can't account for -->
    <path class="il-link" d="M42 51L68 69" />
    <path class="il-shield" d="M54 79l18-7 18 7v14c0 11-7.5 19-18 22.5-10.5-3.5-18-11.5-18-22.5z" />
    <path class="il-check" d="M62 90l7 7 13-14" />

    <circle class="il-ring" cx="26" cy="40" r="15" />
    <circle class="il-dot" cx="26" cy="40" r="6.5" />
  </svg>
)}

{step === "fly" && (
  <svg class="illo" viewBox="0 0 240 120" role="img" aria-label="Miles landing in your own account, then the seat booked">
    <path class="il-line" d="M-10 58H26C70 58 106 32 118 22" />

    <!-- The plane IS this step's motif, and the wave already carries the eye
         from the coral waypoint straight into it — so no tether is needed here
         and a second, smaller plane would only read as a stray arrowhead. The
         notch at (17,21) lands on the path's last point (118,22). -->
    <g class="il-plane" transform="translate(101 1)">
      <path d="M0 16L34 0 22 34 17 21z" />
    </g>

    <circle class="il-ring" cx="26" cy="58" r="15" />
    <circle class="il-dot" cx="26" cy="58" r="6.5" />
  </svg>
)}

<style>
  .illo { display:block; width:100%; height:auto; margin-bottom:20px; overflow:visible; }
  /* Below this the three columns are too narrow to draw the wave legibly, and
     the steps run as a compact three-up text row instead. Scoped here rather
     than in flightdeck.css because Astro's scoping makes the rule above and a
     `.steps .illo` override equally specific — same-specificity ties go to
     whichever loads last, which is this file. */
  @media (max-width:820px){ .illo { display:none; } }

  /* the route — one unbroken stroke the whole way across */
  .il-line { fill:none; stroke:var(--cobalt); stroke-width:2.5; stroke-linecap:round; }

  /* the waypoint — the ONLY coral in the set, one per step */
  .il-ring { fill:none; stroke:var(--cobalt-line); stroke-width:2.5; }
  .il-dot  { fill:var(--coral); }

  /* step 1 — the selector */
  .il-opt    { fill:var(--mist); }
  .il-opt-on { fill:var(--cobalt); }

  /* the tether from a motif back to its own waypoint — dotted so it reads as a
     relationship, not as more of the route */
  .il-link { fill:none; stroke:var(--cobalt-line); stroke-width:2.5; stroke-linecap:round; stroke-dasharray:1 8; }

  /* step 2 — the quote, held */
  .il-shield { fill:none; stroke:var(--cobalt-line); stroke-width:2.5; stroke-linejoin:round; }
  .il-check  { fill:none; stroke:var(--cobalt); stroke-width:2.5; stroke-linecap:round; stroke-linejoin:round; }

  /* step 3 — the seat */
  .il-plane  { fill:var(--cobalt); }
</style>
