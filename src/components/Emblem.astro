---
// Baggage-tag emblem — uniform kraft tag with a punched hole and the IATA
// code in mono. Abstract mark (not an airline logo); we are not affiliated.
// `color` is used only as a small accent stripe, not the whole tile.
const { code = "", color = "#EE4B2B", size = 46 } = Astro.props;
---
<span class="emblem" style={`width:${size}px;height:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 52 52" width={size} height={size}>
    <rect x="2" y="2" width="48" height="48" rx="11" fill="#E7DAB8" stroke="#B4A47F" stroke-width="1.5"/>
    <rect x="2" y="2" width="48" height="7" rx="3.5" fill={color} opacity="0.9"/>
    <circle cx="26" cy="18" r="3.4" fill="none" stroke="#1A1712" stroke-width="2"/>
    <text x="26" y="41" text-anchor="middle" font-family="'IBM Plex Mono', ui-monospace, monospace" font-weight="700" font-size="16" letter-spacing="0.5" fill="#1A1712">{code}</text>
  </svg>
</span>
