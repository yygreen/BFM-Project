---
// Colourful program emblem — a tail-fin swoosh + IATA code on the program's
// brand colour. Abstract mark (not an airline logo); we are not affiliated.
const { code = "", color = "#2159B8", size = 48 } = Astro.props;
const gid = `em-${code}`;
---
<span class="emblem" style={`width:${size}px;height:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 52 52" width={size} height={size}>
    <defs>
      <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color={color}/>
        <stop offset="1" stop-color={color} stop-opacity="0.78"/>
      </linearGradient>
    </defs>
    <rect width="52" height="52" rx="15" fill={`url(#${gid})`}/>
    <path d="M6 42 C24 36 36 22 48 8 C44 26 32 40 14 46 Z" fill="#fff" fill-opacity="0.15"/>
    <path d="M44 9 C40 25 30 37 15 44" fill="none" stroke="#fff" stroke-opacity="0.25" stroke-width="1.5"/>
    <text x="26" y="34" text-anchor="middle" font-family="Archivo, system-ui, sans-serif" font-weight="800" font-size="19" letter-spacing="0.5" fill="#fff">{code}</text>
  </svg>
</span>
