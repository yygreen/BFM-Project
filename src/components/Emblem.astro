---
// Program emblem — a clean cobalt squircle with the IATA code and a coral
// accent dot. Uniform across programs (abstract mark, not an airline logo).
const { code = "", color = "#FF5C3A", size = 46 } = Astro.props;
const gid = `em-${code}`;
---
<span class="emblem" style={`width:${size}px;height:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 52 52" width={size} height={size}>
    <defs>
      <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#2540FF"/><stop offset="1" stop-color="#4A2FFF"/>
      </linearGradient>
    </defs>
    <rect width="52" height="52" rx="16" fill={`url(#${gid})`}/>
    <circle cx="41" cy="12" r="5" fill="#FF5C3A"/>
    <text x="24" y="34" text-anchor="middle" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-weight="800" font-size="19" letter-spacing="0.3" fill="#fff">{code}</text>
  </svg>
</span>
