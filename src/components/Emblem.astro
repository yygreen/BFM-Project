---
// Programme emblem.
//
// If the entry supplies `logo`, that image is used. Otherwise we draw an
// abstract tail-fin badge in the carrier's brand colour — recognisably
// "an airline", distinct per programme, and not a trademark.
//
// The logo slot is empty by default on purpose: the footer states we are not
// affiliated with any airline, and showing carrier marks next to a resale
// offer is the clearest way to imply otherwise. See CLAUDE.md.
const { code = "", color = "#2540FF", size = 46, logo = null, logoAlt = null } = Astro.props;
const gid = `em-${code}-${size}`;
---
{logo ? (
  /* carrier logos are wordmarks — wide, not square. Cap the height and let
     the width follow the artwork rather than squashing it into a tile. */
  <span class="emblem emblem-logo" style={`height:${Math.round(size * 0.62)}px`}>
    <img src={logo} alt={logoAlt || `${code} logo`} loading="lazy" decoding="async" />
  </span>
) : (
  <span class="emblem" style={`width:${size}px;height:${size}px`} aria-hidden="true">
    <svg viewBox="0 0 52 52" width={size} height={size}>
      <defs>
        <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color={color} />
          <stop offset="1" stop-color={color} stop-opacity="0.78" />
        </linearGradient>
      </defs>
      <rect width="52" height="52" rx="16" fill={`url(#${gid})`} />
      <!-- tail fin: swept back, the universal shorthand for a carrier -->
      <path d="M13 38 L30 12 L36 12 L34 38 Z" fill="#fff" fill-opacity="0.17" />
      <path d="M30 12 L36 12 L34 38 L30 38 Z" fill="#fff" fill-opacity="0.13" />
      <text x="26" y="34" text-anchor="middle" font-family="'Plus Jakarta Sans', system-ui, sans-serif"
        font-weight="800" font-size="18" letter-spacing="0.4" fill="#fff">{code}</text>
    </svg>
  </span>
)}
